  "antiMetricPolicy": "A numeric score is only an inspection aid. It cannot widen a support claim without linked fixtures, validators, comparator captures, and conformance reports.",
  "taskEvidenceTiers": [
    {
      "id": "fixture-proven",
      "description": "Committed fixtures and expected outputs prove only declared examples.",
      "minimumEvidence": [
        "development fixture refs",
        "validation fixture refs",
        "negative controls",
        "conformance report refs"
      ]
    },
    {
      "id": "comparator-backed",
      "description": "At least one executed external comparator or validator capture exists, with version and difference policy.",
      "minimumEvidence": [
        "fixture-proven evidence",
        "external comparator refs",
        "difference policy or known-gap statement"
      ]
    },
    {
      "id": "corpus-backed",
      "description": "Committed or reproducibly fetched corpus slices, provenance, expected outputs, and conformance reports exist.",
      "minimumEvidence": [
        "corpus slice policy",
        "corpus provenance",
        "expected outputs or qrels",
        "conformance report refs"
      ]
    },
    {
      "id": "broad-multilingual",
      "description": "Corpus-backed evidence spans declared language/script families and includes holdout evidence.",
      "minimumEvidence": [
        "corpus-backed evidence",
        "language/script coverage matrix",
        "holdout refs",
        "negative controls by family"
      ]
    },
    {
      "id": "release-stable",
      "description": "Broad evidence is backed by API compatibility, performance regression gates, release checks, and limitation review.",
      "minimumEvidence": [
        "broad-multilingual evidence when applicable",
        "release gates",
        "performance evidence",
        "compatibility/deprecation policy"
      ]
    }
  ]
