  "notes": [
    "This matrix prevents claims from escalating from Unicode or smoke-fixture evidence to broad language support.",
    "New language/script fixtures must move through task-specific expected-output and comparator gates before their behavior is claimed."
  ],
  "coverageLevels": [
    {
      "name": "unicode-invariant",
      "status": "present",
      "definition": "Behavior is defined by Unicode-pinned algorithms and should be invariant across human languages unless a later resource/profile layer says otherwise.",
      "claimBoundary": "Applies to implemented Unicode primitives and exact offset accounting only.",
      "evidenceRefs": [
        "packages/textfacts/testdata/unicode/17.0.0",
        "fixtures/tokenization-sbd/slices.json",
        "fixtures/tokenization-sbd/expected/arabic.json",
        "fixtures/tokenization-sbd/expected/japanese-cjk.json",
        "fixtures/tokenization-sbd/expected/thai-no-space.json"
      ],
      "limitations": [
        "Unicode-invariant does not mean language-aware tokenization, morphology, parsing, or named-entity support."
      ]
    },
    {
      "name": "fixture-proven",
      "status": "partial",
      "definition": "Behavior is proven only for named frozen fixtures and their expected outputs.",
      "claimBoundary": "No behavior claim extends beyond the listed fixture slices.",
      "evidenceRefs": [
        "fixtures/tokenization-sbd/slices.json",
        "fixtures/conllu-dependency/slices.json",
        "fixtures/pos-morph-lemma/slices.json",
        "fixtures/rule-backed-ner/slices.json"
      ],
      "limitations": [
        "The fixture set is intentionally small and not a language coverage benchmark."
      ]
    },
    {
      "name": "resource-backed",
      "status": "partial",
      "definition": "Behavior is backed by declared resources, licenses, provenance, and deterministic lookup rules.",
      "claimBoundary": "Current public resource proof is manifest/lookup behavior, not a broad multilingual resource registry.",
      "evidenceRefs": [
        "fixtures/textpack/manifests/textpack-en-core.json",
        "fixtures/textpack/manifests/textpack-en-legal.json",
        "fixtures/textpack/README.md"
      ],
      "limitations": [
        "Current resource fixtures are not a multilingual resource inventory."
      ]
    },
    {
      "name": "comparator-backed",
      "status": "partial",
      "definition": "Behavior or evidence has been compared against at least one named external tool/version.",
      "claimBoundary": "Comparator evidence is diagnostic and does not override the repository contract.",
      "evidenceRefs": [
        "fixtures/tokenization-sbd/comparisons/spacy-3.8.14.json",
