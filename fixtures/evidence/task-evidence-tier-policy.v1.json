  "tierDefinitions": [
    {
      "id": "fixture-proven",
      "definition": "Committed fixtures and expected outputs prove only declared examples.",
      "minimumEvidence": [
        "development fixture refs",
        "validation fixture refs",
        "negative controls",
        "conformance report refs"
      ],
      "claimBoundary": "No behavior claim extends beyond named fixtures."
    },
    {
      "id": "comparator-backed",
      "definition": "At least one executed external comparator or validator capture exists, with version and difference policy.",
      "minimumEvidence": [
        "fixture-proven evidence",
        "external comparator refs",
        "difference policy or known-gap statement"
      ],
      "claimBoundary": "Comparator evidence is diagnostic and scoped to captured inputs."
    },
    {
      "id": "corpus-backed",
      "definition": "Committed or reproducibly fetched corpus slices, provenance, expected outputs, and conformance reports exist.",
      "minimumEvidence": [
        "corpus slice policy",
        "corpus provenance",
        "expected outputs or qrels",
        "conformance report refs"
      ],
      "claimBoundary": "Corpus evidence is limited to declared corpora, splits, and metrics."
    },
    {
      "id": "broad-multilingual",
      "definition": "Corpus-backed evidence spans declared language/script families and includes holdout evidence.",
      "minimumEvidence": [
        "corpus-backed evidence",
        "language/script coverage matrix",
        "holdout refs",
        "negative controls by family"
      ],
      "claimBoundary": "Broad multilingual claims name covered language/script families and exclusions."
    },
    {
      "id": "release-stable",
      "definition": "Broad evidence is backed by API compatibility, performance regression gates, release checks, and limitation review.",
      "minimumEvidence": [
        "broad-multilingual evidence when applicable",
        "release gates",
        "performance evidence",
        "compatibility/deprecation policy"
      ],
      "claimBoundary": "Release-stable claims apply only to the declared package and task surfaces."
    }
  ],
