{
	"extends": "./tsconfig.json",
	"compilerOptions": {
		"noEmit": false,
		"declaration": true,
		"declarationMap": true,
		"sourceMap": true,
		"outDir": "dist",
		"rootDir": "src",
		"allowImportingTsExtensions": false,
		"paths": {},
		"types": ["node"]
	},
	"include": ["src/**/*.ts"],
	"exclude": ["test/**/*.ts"]
}
