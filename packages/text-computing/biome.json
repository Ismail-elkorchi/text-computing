{
	"$schema": "https://biomejs.dev/schemas/2.4.15/schema.json",
	"files": {
		"includes": [
			"**",
			"!**/dist",
			"!**/dist-test",
			"!**/src/**/generated",
			"!**/testdata",
			"!**/specs"
		]
	},
	"overrides": [
		{
			"includes": ["src/unicode/**", "test/unicode/**"],
			"formatter": {
				"indentStyle": "space",
				"indentWidth": 2,
				"lineWidth": 100
			},
			"assist": { "actions": { "source": { "organizeImports": "off" } } }
		}
	]
}
