{
	"name": "@ismail-elkorchi/textpack-fr",
	"version": "0.1.0",
	"description": "Self-contained French resources for ordinary document NLP; heavy corpus, parallel, and annotation datasets are acquired separately.",
	"type": "module",
	"sideEffects": false,
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./pack.manifest.json": "./pack.manifest.json"
	},
	"scripts": {
		"build": "node ../../../tools/clean-build-output.mjs dist && tsc -p tsconfig.build.json",
		"lint": "biome check src test README.md package.json tsconfig.json tsconfig.build.json --files-ignore-unknown=true",
		"check:static": "tsc -p tsconfig.build.json --noEmit --noUnusedLocals --noUnusedParameters",
		"check:pack": "npm pack --dry-run",
		"test": "npm run test:all",
		"prepack": "npm run build",
		"test:all": "npm run -s build && node test/smoke.mjs && npm run -s check:pack"
	},
	"dependencies": {
		"@ismail-elkorchi/textpack": "0.1.0"
	},
	"license": "SEE LICENSE IN LICENSE.generated.md",
	"files": [
		"dist",
		"pack.manifest.json",
		"resources/bcp47.language-registry.summary.json",
		"resources/bcp47.language-subtags.tsv.gz.b64",
		"resources/cldr-48.core.summary.json",
		"resources/cldr-48.likely-subtags.tsv.gz.b64",
		"resources/cldr-48.locale-aliases.tsv",
		"resources/cldr-48.script-data.tsv",
		"resources/fr.core.basic-segmentation.json",
		"resources/fr.core.language-profile.json",
		"resources/fr.core.orthography.tsv",
		"resources/fr.core.punctuation.tsv",
		"resources/fr.core.quality-profile.json",
		"resources/fr.core.quality.json",
		"resources/fr.normalization-contraction-forms.tsv",
		"resources/fr.normalization-elision-prefixes.tsv",
		"resources/fr.normalization-gold-cases.json",
		"resources/fr.normalization-rules.tsv",
		"resources/fr.normalization.json",
		"resources/fr.normalization.quality-profile.json",
		"resources/fr.normalization.quality.json",
		"resources/fr.segmentation-abbreviations.tsv",
		"resources/fr.segmentation-boundary-properties.tsv",
		"resources/fr.segmentation-contraction-forms.tsv",
		"resources/fr.segmentation-elision-prefixes.tsv",
		"resources/fr.segmentation-gold-cases.json",
		"resources/fr.segmentation.grapheme.json",
		"resources/fr.segmentation.quality-profile.json",
		"resources/fr.segmentation.quality.json",
		"resources/fr.segmentation.sentence.json",
		"resources/fr.segmentation.token.json",
		"resources/fr.segmentation.word.json",
		"resources/lexique-383.entries.lookup-index.v1.txt",
		"resources/lexique-383.lemmas.tsv.gz.b64",
		"resources/lexique-383.lexicon.json",
		"resources/lexique-383.morphology.json",
		"resources/lexique-383.pos.tsv",
		"resources/lexique-383.quality-profile.json",
		"resources/lexique-383.quality.json",
		"resources/lexique-383.search-profile.json",
		"resources/unicode-17.blocks.tsv",
		"resources/unicode-17.core.summary.json",
		"resources/unicode-17.property-value-aliases.tsv",
		"resources/unicode-17.scripts.tsv.gz.b64",
		"resources/unimorph-fra.features.tsv",
		"resources/unimorph-fra.morphology.json",
		"resources/unimorph-fra.paradigms.lookup-index.v1.txt",
		"resources/unimorph-fra.pos.tsv",
		"resources/unimorph-fra.quality-profile.json",
		"resources/unimorph-fra.quality.json",
		"resources/wikidata-fr.aliases.lookup-index.v1.txt",
		"resources/wikidata-fr.entities.lookup-index.v1.txt",
		"resources/wikidata-fr.kb.json",
		"resources/wikidata-fr.quality-profile.json",
		"resources/wikidata-fr.quality.json",
		"resources/wikidata-fr.relations.lookup-index.v1.txt",
		".textpack-generated.json",
		"licenses",
		"LICENSE.generated.md",
		"NOTICE.generated.md",
		"SOURCES.generated.json",
		"ATTRIBUTION.generated.md",
		"COVERAGE.generated.json",
		"EVALUATION.generated.json",
		"QUALITY.generated.json",
		"README.md",
		"CHANGELOG.md"
	],
	"publishConfig": {
		"access": "public"
	}
}
