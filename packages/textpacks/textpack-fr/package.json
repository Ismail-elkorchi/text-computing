{
	"name": "@ismail-elkorchi/textpack-fr",
	"version": "0.1.0",
	"description": "Generated private artifact-backed French policy-expanded recipe composite over the current audited French component graph.",
	"type": "module",
	"sideEffects": false,
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./pack.manifest.json": "./pack.manifest.json"
	},
	"scripts": {
		"build": "node ../../../tools/clean-build-output.mjs dist && tsc -p tsconfig.build.json",
		"lint": "biome check src test README.md package.json tsconfig.json tsconfig.build.json --files-ignore-unknown=true",
		"check:static": "tsc -p tsconfig.build.json --noEmit --noUnusedLocals --noUnusedParameters",
		"check:pack": "npm pack --dry-run",
		"test": "npm run test:all",
		"prepack": "npm run build",
		"test:all": "npm run -s build && node test/smoke.mjs && node test/negative.mjs && npm run -s check:pack"
	},
	"dependencies": {
		"@ismail-elkorchi/textpack": "0.1.0",
		"@ismail-elkorchi/textpack-foundation": "0.1.0",
		"@ismail-elkorchi/textpack-fr-core": "0.1.0",
		"@ismail-elkorchi/textpack-fr-normalization": "0.1.0",
		"@ismail-elkorchi/textpack-fr-segmentation": "0.1.0",
		"@ismail-elkorchi/textpack-fr-lexicon": "0.1.0",
		"@ismail-elkorchi/textpack-fr-morphology": "0.1.0",
		"@ismail-elkorchi/textpack-fr-syntax": "0.1.0",
		"@ismail-elkorchi/textpack-fr-kb": "0.1.0",
		"@ismail-elkorchi/textpack-fr-search": "0.1.0",
		"@ismail-elkorchi/textpack-fr-corpus": "0.1.0",
		"@ismail-elkorchi/textpack-fr-parallel": "0.1.0",
		"@ismail-elkorchi/textpack-fr-quality": "0.1.0"
	},
	"license": "SEE LICENSE IN LICENSE.generated.md",
	"files": [
		"dist",
		"pack.manifest.json",
		".textpack-generated.json",
		"licenses",
		"LICENSE.generated.md",
		"NOTICE.generated.md",
		"SOURCES.generated.json",
		"ATTRIBUTION.generated.md",
		"COVERAGE.generated.json",
		"EVALUATION.generated.json",
		"QUALITY.generated.json",
		"README.md",
		"CHANGELOG.md"
	],
	"private": true
}
