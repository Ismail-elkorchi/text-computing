{
	"name": "@ismail-elkorchi/textpack-ar",
	"version": "0.1.0",
	"description": "Self-contained Arabic resources for ordinary document NLP; heavy corpus, parallel, and annotation datasets are acquired separately.",
	"type": "module",
	"sideEffects": false,
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./pack.manifest.json": "./pack.manifest.json"
	},
	"scripts": {
		"build": "node ../../../tools/clean-build-output.mjs dist && tsc -p tsconfig.build.json",
		"lint": "biome check src test README.md package.json tsconfig.json tsconfig.build.json --files-ignore-unknown=true",
		"check:static": "tsc -p tsconfig.build.json --noEmit --noUnusedLocals --noUnusedParameters",
		"check:pack": "npm pack --dry-run",
		"test": "npm run test:all",
		"prepack": "npm run build",
		"test:all": "npm run -s build && node test/smoke.mjs && npm run -s check:pack"
	},
	"dependencies": {
		"@ismail-elkorchi/textpack": "0.1.0"
	},
	"license": "SEE LICENSE IN LICENSE.generated.md",
	"files": [
		"dist",
		"pack.manifest.json",
		"resources/bcp47.language-subtags.tsv.gz.b64",
		"resources/bcp47.language-registry.summary.json",
		"resources/unicode-17.blocks.tsv",
		"resources/unicode-17.property-value-aliases.tsv",
		"resources/unicode-17.scripts.tsv.gz.b64",
		"resources/unicode-17.core.summary.json",
		"resources/cldr-48.likely-subtags.tsv.gz.b64",
		"resources/cldr-48.locale-aliases.tsv",
		"resources/cldr-48.script-data.tsv",
		"resources/cldr-48.core.summary.json",
		"resources/ar.core.language-profile.json",
		"resources/ar.core.orthography.tsv",
		"resources/ar.core.punctuation.tsv",
		"resources/ar.core.basic-segmentation.json",
		"resources/ar.core.quality.json",
		"resources/ar.core.quality-profile.json",
		"resources/ar.normalization-rules.tsv",
		"resources/ar.normalization-observed-codepoints.tsv",
		"resources/ar.normalization.json",
		"resources/ar.normalization.quality.json",
		"resources/ar.normalization.quality-profile.json",
		"resources/camel-morph-msa.features.tsv",
		"resources/camel-morph-msa.defaults.tsv",
		"resources/camel-morph-msa.tokenizations.tsv",
		"resources/camel-morph-msa.morphemes.tsv.gz.b64",
		"resources/camel-morph-msa.compatibility.tsv.gz.b64",
		"resources/camel-morph-msa.quality.json",
		"resources/camel-morph-msa.morphology.json",
		"resources/camel-morph-msa.segmentation.json",
		"resources/camel-morph-msa.quality-profile.json",
		"resources/camel-morph-msa.morphemes.lookup-index.tsv.gz.b64",
		"resources/wordnet-ar.lexical-entries.tsv.gz.b64",
		"resources/wordnet-ar.senses.tsv.gz.b64",
		"resources/wordnet-ar.synsets.tsv.gz.b64",
		"resources/wordnet-ar.relations.tsv.gz.b64",
		"resources/wordnet-ar.quality.json",
		"resources/wordnet-ar.lexicon.json",
		"resources/wordnet-ar.kb.json",
		"resources/wordnet-ar.quality-profile.json",
		"resources/wikidata-ar.entities.tsv.gz.b64",
		"resources/wikidata-ar.aliases.tsv.gz.b64",
		"resources/wikidata-ar.relations.tsv.gz.b64",
		"resources/wikidata-ar.kb.json",
		"resources/wikidata-ar.quality.json",
		"resources/wikidata-ar.quality-profile.json",
		"resources/ar.search.profile.json",
		"resources/ar.search.quality.json",
		"resources/ar.search.quality-profile.json",
		".textpack-generated.json",
		"licenses",
		"LICENSE.generated.md",
		"NOTICE.generated.md",
		"SOURCES.generated.json",
		"ATTRIBUTION.generated.md",
		"COVERAGE.generated.json",
		"EVALUATION.generated.json",
		"QUALITY.generated.json",
		"README.md",
		"CHANGELOG.md"
	],
	"publishConfig": {
		"access": "public"
	}
}
