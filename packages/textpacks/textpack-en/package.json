{
	"name": "@ismail-elkorchi/textpack-en",
	"version": "0.1.0",
	"description": "Audited English capabilities for deployable document NLP; heavy corpus, parallel, and annotation datasets are acquired separately.",
	"type": "module",
	"sideEffects": false,
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./pack.manifest.json": "./pack.manifest.json"
	},
	"scripts": {
		"build": "node ../../../tools/clean-build-output.mjs dist && tsc -p tsconfig.build.json",
		"lint": "biome check src test README.md package.json tsconfig.json tsconfig.build.json --files-ignore-unknown=true",
		"check:static": "tsc -p tsconfig.build.json --noEmit --noUnusedLocals --noUnusedParameters",
		"check:pack": "npm pack --dry-run",
		"test": "npm run test:all",
		"prepack": "npm run build",
		"test:all": "npm run -s build && node test/smoke.mjs && npm run -s check:pack"
	},
	"dependencies": {
		"@ismail-elkorchi/textpack": "0.1.0"
	},
	"license": "SEE LICENSE IN LICENSE.generated.md",
	"files": [
		"dist",
		"pack.manifest.json",
		"resources/bcp47.language-registry.summary.json",
		"resources/bcp47.language-subtags.tsv.gz.b64",
		"resources/cldr-48.core.summary.json",
		"resources/cldr-48.likely-subtags.tsv.gz.b64",
		"resources/cldr-48.locale-aliases.tsv",
		"resources/cldr-48.script-data.tsv",
		"resources/en.core.abbreviations.tsv.gz.b64",
		"resources/en.core.basic-segmentation.json",
		"resources/en.core.function-words.tsv",
		"resources/en.core.language-profile.json",
		"resources/en.core.orthography.tsv",
		"resources/en.core.punctuation.tsv",
		"resources/en.core.quality-profile.json",
		"resources/en.core.quality.json",
		"resources/en.normalization-rules.tsv",
		"resources/en.normalization.json",
		"resources/en.normalization.quality-profile.json",
		"resources/en.normalization.quality.json",
		"resources/en.segmentation-boundary-properties.tsv",
		"resources/en.segmentation.grapheme.json",
		"resources/en.segmentation.quality-profile.json",
		"resources/en.segmentation.quality.json",
