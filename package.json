{
	"name": "text-computing",
	"version": "0.0.0",
	"description": "Workspace for deterministic text computing packages.",
	"private": true,
	"type": "module",
	"sideEffects": false,
	"workspaces": [
		"packages/*",
		"packages/textpacks/*"
	],
	"scripts": {
		"build": "node tools/build-workspaces.mjs",
		"lint": "npm run --workspaces --if-present lint && npm run -s check:boundaries && npm run -s check:public-language",
		"check:boundaries": "node tools/check-boundaries.mjs",
		"check:public-language": "node tools/check-public-language.mjs",
		"schema:validate": "node tools/validate-repo-schemas.mjs && node tools/validate-textpack-packages.mjs && npm -w @ismail-elkorchi/textfacts run schema:validate",
		"test:forge": "node --test tools/textpack-forge/test/*.test.mjs",
		"test:nlp": "node tools/run-nlp-benchmarks.mjs && node tools/run-nlp-cold-benchmarks.mjs",
		"test:nlp:cold": "node tools/run-nlp-cold-benchmarks.mjs",
		"forge:build": "node tools/textpack-forge/cli.mjs build",
		"forge:acquire": "node tools/textpack-forge/cli.mjs acquire",
		"forge:verify": "node tools/textpack-forge/cli.mjs verify",
		"forge:license-audit": "node tools/textpack-forge/cli.mjs license-audit",
		"forge:drift": "node tools/textpack-forge/cli.mjs drift",
		"forge:inventory": "node tools/textpack-forge/cli.mjs inventory",
		"forge:reports": "node tools/textpack-forge/cli.mjs reports",
		"forge:size": "node tools/textpack-forge/cli.mjs size",
		"forge:snapshot-update": "node tools/textpack-forge/cli.mjs snapshot-update",
		"check:static": "npm run --workspaces --if-present check:static",
		"check:pack": "npm -w @ismail-elkorchi/textfacts run check:pack",
		"check:publint": "npm -w @ismail-elkorchi/textfacts run check:publint",
		"check:attw": "npm -w @ismail-elkorchi/textfacts run check:attw",
		"check:jsr": "npm -w @ismail-elkorchi/textfacts run check:jsr"
	},
	"devDependencies": {
		"@arethetypeswrong/cli": "0.18.2",
		"@biomejs/biome": "2.4.15",
		"@types/node": "25.9.1",
		"ajv": "8.20.0",
		"esbuild": "0.28.1",
		"publint": "0.3.21",
		"typescript": "6.0.3"
	},
	"license": "MIT"
}
