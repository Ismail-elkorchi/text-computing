{
	"$schema": "http://json-schema.org/draft-07/schema#",
	"title": "TextpackForgeResourceTransform",
	"type": "object",
	"additionalProperties": false,
	"required": [
		"schemaVersion",
		"resourceSpecId",
		"packageName",
		"pipelineId",
		"pipelineVersion",
		"sourceIds",
		"snapshotIds",
		"inputFiles",
		"outputs"
	],
	"properties": {
		"schemaVersion": { "const": "1" },
		"resourceSpecId": { "type": "string", "minLength": 1 },
		"packageName": { "type": "string", "minLength": 1 },
		"pipelineId": {
			"enum": [
				"camel-morph-msa",
				"cldr-core-foundation",
				"iana-language-registry",
				"open-english-wordnet-lmf",
				"ud-conllu-profile",
				"unicode-17-core"
			]
		},
		"pipelineVersion": { "type": "string", "minLength": 1 },
		"sourceIds": {
			"type": "array",
			"minItems": 1,
			"items": { "type": "string", "minLength": 1 }
		},
		"snapshotIds": {
			"type": "array",
			"minItems": 1,
			"items": { "type": "string", "minLength": 1 }
		},
		"inputFiles": {
			"type": "array",
			"minItems": 1,
			"items": {
				"type": "object",
				"additionalProperties": false,
				"required": ["snapshotId", "path", "checksum"],
				"properties": {
					"snapshotId": { "type": "string", "minLength": 1 },
					"path": { "type": "string", "minLength": 1 },
					"checksum": { "type": "string", "minLength": 1 }
				}
			}
		},
		"outputs": {
			"type": "array",
			"minItems": 1,
			"items": {
				"type": "object",
				"additionalProperties": false,
				"required": ["resourceId", "path", "kind", "format"],
				"properties": {
					"resourceId": { "type": "string", "minLength": 1 },
					"path": { "type": "string", "minLength": 1 },
					"kind": { "type": "string", "minLength": 1 },
					"format": { "type": "string", "minLength": 1 }
				}
			}
		}
	}
}
