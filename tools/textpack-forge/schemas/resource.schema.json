{
	"$schema": "http://json-schema.org/draft-07/schema#",
	"title": "TextpackForgeResourceTransform",
	"type": "object",
	"additionalProperties": false,
	"required": [
		"schemaVersion",
		"resourceSpecId",
		"packageName",
		"pipelineId",
		"pipelineVersion",
		"sourceIds",
		"snapshotIds",
		"inputFiles",
		"outputs"
	],
	"properties": {
		"schemaVersion": { "const": "1" },
		"resourceSpecId": { "type": "string", "minLength": 1 },
		"packageName": { "type": "string", "minLength": 1 },
		"pipelineId": {
			"enum": [
				"arabic-core-profile",
				"arabic-normalization-profile",
				"arabic-search-profile",
				"arabic-wordnet-lmf",
				"camel-morph-msa",
				"cldr-core-foundation",
				"english-core-profile",
				"english-normalization-profile",
				"english-segmentation-profile",
				"esdb-wordlist-diff",
				"french-core-profile",
				"french-lexique-383",
				"french-normalization-profile",
				"french-segmentation-profile",
				"iana-language-registry",
				"open-english-wordnet-lmf",
				"scowl-v2-inflection",
				"tatoeba-arabic-corpus-artifact",
				"tatoeba-arabic-parallel-artifact",
				"tatoeba-english-corpus-artifact",
				"tatoeba-english-parallel-artifact",
				"tatoeba-french-corpus-artifact",
				"tatoeba-french-parallel-artifact",
				"ud-conllu-profile",
				"unicode-17-core",
				"wikidata-main-artifact"
			]
		},
		"pipelineVersion": { "type": "string", "minLength": 1 },
		"sourceIds": {
			"type": "array",
			"minItems": 1,
			"items": { "type": "string", "minLength": 1 }
		},
		"snapshotIds": {
			"type": "array",
			"minItems": 1,
			"items": { "type": "string", "minLength": 1 }
		},
		"inputFiles": {
			"type": "array",
			"minItems": 1,
			"items": {
				"type": "object",
				"additionalProperties": false,
				"required": ["snapshotId", "path", "checksum"],
				"properties": {
					"snapshotId": { "type": "string", "minLength": 1 },
					"path": { "type": "string", "minLength": 1 },
					"checksum": { "type": "string", "minLength": 1 }
				}
			}
		},
		"outputs": {
			"type": "array",
			"minItems": 1,
			"items": {
				"type": "object",
				"additionalProperties": false,
				"required": ["resourceId", "path", "kind", "format"],
				"properties": {
					"resourceId": { "type": "string", "minLength": 1 },
					"path": { "type": "string", "minLength": 1 },
					"kind": { "type": "string", "minLength": 1 },
					"format": { "type": "string", "minLength": 1 },
					"lookupKeyColumns": {
						"type": "array",
						"minItems": 1,
						"uniqueItems": true,
						"items": { "type": "string", "minLength": 1 }
					},
					"lookupEmptyKeyColumns": {
						"type": "array",
						"minItems": 1,
						"uniqueItems": true,
						"items": { "type": "string", "minLength": 1 }
					},
					"lookupPatternColumns": {
						"type": "array",
						"minItems": 1,
						"uniqueItems": true,
						"items": { "type": "string", "minLength": 1 }
					}
				}
			}
		}
	}
}
