{
	"$schema": "http://json-schema.org/draft-07/schema#",
	"title": "TextpackForgeCompositeSpec",
	"type": "object",
	"additionalProperties": false,
	"required": [
		"schemaVersion",
		"mode",
		"packageName",
		"packageDir",
		"name",
		"description",
		"version",
		"packClass",
		"supportLevel",
		"display",
		"targets",
		"buildUnits",
		"capabilitySlots",
		"license",
		"citations"
	],
	"properties": {
		"schemaVersion": { "const": "1" },
		"mode": { "const": "source-backed" },
		"packageName": { "type": "string", "minLength": 1 },
		"packageDir": { "type": "string", "minLength": 1 },
		"name": { "type": "string", "minLength": 1 },
		"description": { "type": "string", "minLength": 1 },
		"policySurface": {
			"enum": ["default", "license-inclusive"]
		},
		"publishable": { "type": "boolean" },
		"publishabilityEvidence": {
			"type": "object",
			"additionalProperties": false,
			"properties": {
				"productionGradeSourceCoverage": { "type": "string", "minLength": 1 },
				"auditedLicense": { "type": "string", "minLength": 1 },
				"declaredScope": { "type": "string", "minLength": 1 },
				"conformanceEvidence": {
					"type": "array",
					"minItems": 1,
					"items": { "type": "string", "minLength": 1 }
				},
				"generatedReports": {
					"type": "array",
					"minItems": 1,
					"items": { "type": "string", "minLength": 1 }
				}
			}
		},
		"version": { "type": "string", "minLength": 1 },
		"packClass": { "const": "language-composite" },
		"supportLevel": {
			"enum": [
				"registered",
				"unicode-covered",
				"profiled",
				"artifact-backed",
				"task-supported",
				"feature-complete"
			]
		},
		"display": {
			"type": "object",
			"additionalProperties": false,
			"required": ["languageName"],
			"properties": {
				"languageName": { "type": "string", "minLength": 1 }
			}
		},
		"targets": { "type": "object" },
		"buildUnits": {
			"type": "array",
			"minItems": 1,
			"uniqueItems": true,
			"items": {
				"type": "object",
				"additionalProperties": false,
				"required": ["buildUnitId", "reason", "licensePolicy"],
				"properties": {
					"buildUnitId": {
						"type": "string",
						"pattern": "^[a-z0-9][a-z0-9._-]*$"
					},
					"reason": { "type": "string", "minLength": 1 },
					"licensePolicy": {
						"enum": [
							"default",
							"allow-attribution",
							"allow-share-alike",
							"allow-copyleft",
							"local-only"
						]
					}
				}
			}
		},
		"capabilitySlots": {
			"type": "array",
			"minItems": 1,
			"items": {
				"type": "object",
				"additionalProperties": false,
				"required": ["slot", "status", "tier"],
				"properties": {
					"slot": { "type": "string", "minLength": 1 },
					"status": {
						"enum": [
							"unsupported",
							"planned",
							"profiled",
							"artifact-backed",
							"task-supported",
							"feature-complete",
							"not-applicable"
						]
					},
					"tier": {
						"enum": [
							"none",
							"resource-only",
							"baseline",
							"lookup",
							"rule-based",
							"contextual",
							"model-backed"
						]
					},
					"notes": {
						"type": "array",
						"items": { "type": "string", "minLength": 1 }
					}
				}
			}
		},
		"license": { "type": "string", "minLength": 1 },
		"citations": {
			"type": "array",
			"minItems": 1,
			"uniqueItems": true,
			"items": { "type": "string", "minLength": 1 }
		}
	}
}
