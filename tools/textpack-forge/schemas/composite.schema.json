{
	"$schema": "http://json-schema.org/draft-07/schema#",
	"title": "TextpackForgeCompositeSpec",
	"type": "object",
	"additionalProperties": false,
	"required": [
		"schemaVersion",
		"mode",
		"packageName",
		"packageDir",
		"name",
		"description",
		"version",
		"packClass",
		"supportLevel",
		"loader",
		"targets",
		"components",
		"capabilitySlots",
		"license",
		"citations"
	],
	"properties": {
		"schemaVersion": { "const": "1" },
		"mode": { "const": "source-backed" },
		"packageName": { "type": "string", "minLength": 1 },
		"packageDir": { "type": "string", "minLength": 1 },
		"name": { "type": "string", "minLength": 1 },
		"description": { "type": "string", "minLength": 1 },
		"publishable": { "type": "boolean" },
		"publishabilityEvidence": {
			"type": "object",
			"additionalProperties": false,
			"properties": {
				"productionGradeSourceCoverage": { "type": "string", "minLength": 1 },
				"auditedLicense": { "type": "string", "minLength": 1 },
				"declaredScope": { "type": "string", "minLength": 1 },
				"conformanceEvidence": {
					"type": "array",
					"minItems": 1,
					"items": { "type": "string", "minLength": 1 }
				},
				"generatedReports": {
					"type": "array",
					"minItems": 1,
					"items": { "type": "string", "minLength": 1 }
				}
			}
		},
		"version": { "type": "string", "minLength": 1 },
		"packClass": { "enum": ["foundation-composite", "language-composite"] },
		"supportLevel": {
			"enum": [
				"registered",
				"unicode-covered",
				"profiled",
				"task-supported",
				"feature-complete"
			]
		},
		"loader": {
			"type": "object",
			"additionalProperties": false,
			"required": ["functionName", "languageName"],
			"properties": {
				"functionName": { "type": "string", "minLength": 1 },
				"languageName": { "type": "string", "minLength": 1 }
			}
		},
		"languageSupport": { "type": "boolean" },
		"targets": { "type": "object" },
		"sourceIds": {
			"type": "array",
			"minItems": 1,
			"uniqueItems": true,
			"items": { "type": "string", "minLength": 1 }
		},
		"snapshotIds": {
			"type": "array",
			"minItems": 1,
			"uniqueItems": true,
			"items": { "type": "string", "minLength": 1 }
		},
		"components": {
			"type": "array",
			"minItems": 1,
			"items": {
				"type": "object",
				"additionalProperties": false,
				"required": [
					"packageName",
					"versionRange",
					"role",
					"reason",
					"licensePolicy",
					"capabilityPolicy",
					"artifactPolicy"
				],
				"properties": {
					"packageName": { "type": "string", "minLength": 1 },
					"versionRange": { "type": "string", "minLength": 1 },
					"role": { "enum": ["required", "optional", "excluded"] },
					"reason": { "type": "string", "minLength": 1 },
					"licensePolicy": {
						"enum": [
							"default",
							"allow-attribution",
							"allow-share-alike",
							"allow-copyleft",
							"local-only"
						]
					},
					"capabilityPolicy": {
						"enum": [
							"contributes-default",
							"available-optional",
							"documentation-only"
						]
					},
					"artifactPolicy": { "enum": ["none", "locked", "fetch-explicit"] }
				}
			}
		},
		"capabilitySlots": {
			"type": "array",
			"minItems": 1,
			"items": {
				"type": "object",
				"additionalProperties": false,
				"required": ["slot", "status"],
				"properties": {
					"slot": { "type": "string", "minLength": 1 },
					"status": {
						"enum": [
							"unsupported",
							"planned",
							"profiled",
							"artifact-backed",
							"task-supported",
							"feature-complete",
							"not-applicable"
						]
					},
					"notes": {
						"type": "array",
						"items": { "type": "string", "minLength": 1 }
					}
				}
			}
		},
		"license": { "type": "string", "minLength": 1 },
		"citations": {
			"type": "array",
			"minItems": 1,
			"uniqueItems": true,
			"items": { "type": "string", "minLength": 1 }
		}
	}
}
