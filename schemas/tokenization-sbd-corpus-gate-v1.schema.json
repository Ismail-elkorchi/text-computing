{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/Ismail-elkorchi/text-computing/schemas/tokenization-sbd-corpus-gate-v1.schema.json",
  "title": "Tokenization and sentence boundary corpus gate v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "scope",
    "claimBoundary",
    "splitRoles",
    "corpusSlices"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "scope": { "const": "tokenization-sbd-corpus-gate" },
    "claimBoundary": { "type": "string", "minLength": 1 },
    "splitRoles": {
      "type": "array",
      "minItems": 4,
      "uniqueItems": true,
      "items": {
        "enum": ["development", "validation", "holdout", "negative-control"]
      }
    },
    "corpusSlices": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/corpusSlice" }
    },
    "limitations": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "definitions": {
    "repositoryRef": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(docs|fixtures|packages|schemas|tools)/"
    },
    "corpusSlice": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "splitRole",
        "sourceSliceId",
        "expectedOutputRef",
        "language",
        "script",
        "boundaryRegime",
        "provenance",
        "claimUse"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "splitRole": {
          "enum": ["development", "validation", "holdout", "negative-control"]
        },
        "sourceSliceId": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "expectedOutputRef": { "$ref": "#/definitions/repositoryRef" },
        "language": { "type": "string", "minLength": 1 },
        "script": { "type": "string", "minLength": 1 },
        "boundaryRegime": {
          "enum": [
            "space-delimited",
            "right-to-left",
            "no-space",
            "cjk",
            "southeast-asian-no-space",
            "mixed-script",
            "unicode-edge",
            "malformed"
          ]
        },
        "provenance": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "sourceRef", "license"],
          "properties": {
            "kind": { "enum": ["repository-authored-fixture", "reproducible-external-reference"] },
            "sourceRef": { "$ref": "#/definitions/repositoryRef" },
            "license": { "type": "string", "minLength": 1 },
            "externalReference": { "type": "string", "minLength": 1 }
          }
        },
        "claimUse": {
          "enum": [
            "development-only",
            "validation-only",
            "holdout-not-implementation-tuned",
            "negative-control"
          ]
        },
        "notes": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
