{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/Ismail-elkorchi/text-computing/schemas/rule-backed-ner-tool-versions-v1.schema.json",
  "title": "Rule-backed NER label policy v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "targetLabelPolicy",
    "targetLabels",
    "allowNestedSpans",
    "allowOverlapDiagnostics"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "targetLabelPolicy": { "type": "string", "minLength": 1 },
    "targetLabels": {
      "type": "array",
      "minItems": 3,
      "items": { "enum": ["PER", "ORG", "LOC"] }
    },
    "allowNestedSpans": { "const": true },
    "allowOverlapDiagnostics": { "const": true },
    "notes": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
