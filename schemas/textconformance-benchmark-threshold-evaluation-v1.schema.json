{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/Ismail-elkorchi/text-computing/schemas/textconformance-benchmark-threshold-evaluation-v1.schema.json",
  "title": "textconformance benchmark threshold evaluation v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "policyId",
    "benchmarkId",
    "subject",
    "generatedAt",
    "summary",
    "rows",
    "evidenceRefs",
    "limitations"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "policyId": { "type": "string", "minLength": 1 },
    "benchmarkId": { "type": "string", "minLength": 1 },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id"],
      "properties": {
        "kind": { "type": "string", "minLength": 1 },
        "id": { "type": "string", "minLength": 1 },
        "schemaId": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 }
      }
    },
    "generatedAt": { "type": "string", "minLength": 1 },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pass", "warn", "fail", "missing"],
      "properties": {
        "pass": { "type": "integer", "minimum": 0 },
        "warn": { "type": "integer", "minimum": 0 },
        "fail": { "type": "integer", "minimum": 0 },
        "missing": { "type": "integer", "minimum": 0 }
      }
    },
    "rows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["metricId", "status", "message", "evidenceRefs"],
        "properties": {
          "metricId": { "type": "string", "minLength": 1 },
          "status": { "enum": ["pass", "warn", "fail", "missing"] },
          "value": { "type": "number" },
          "unit": { "type": "string", "minLength": 1 },
          "min": { "type": "number" },
          "max": { "type": "number" },
          "warnMin": { "type": "number" },
          "warnMax": { "type": "number" },
          "message": { "type": "string", "minLength": 1 },
          "evidenceRefs": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "evidenceRefs": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "notes": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
