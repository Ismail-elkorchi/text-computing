{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/Ismail-elkorchi/text-computing/schemas/pos-morph-lemma-comparison-v1.schema.json",
  "title": "POS, morphology, and lemma comparator capture v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "scope", "capturedDate", "executionStatus", "captureMode", "offsetUnits", "comparator", "slices"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "scope": { "const": "pos-morph-lemma" },
    "capturedDate": { "type": "string", "pattern": "^20[0-9]{2}-[0-9]{2}-[0-9]{2}$" },
    "executionStatus": { "enum": ["executed", "capability-recorded"] },
    "captureMode": { "enum": ["curated-local-execution", "capability-record"] },
    "offsetUnits": { "const": "utf16-code-unit" },
    "comparator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "runtime", "command", "license", "artifactSurface"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "runtime": { "type": "string", "minLength": 1 },
        "command": { "type": "string", "minLength": 1 },
        "license": { "type": "string", "minLength": 1 },
        "artifactSurface": { "type": "string", "minLength": 1 }
      }
    },
    "dependencies": {
      "type": "array",
      "items": { "$ref": "#/definitions/dependency" }
    },
    "slices": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/slice" }
    },
    "notes": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "definitions": {
    "dependency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "role"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "role": { "type": "string", "minLength": 1 }
      }
    },
    "slice": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sliceId", "status", "tokens"],
      "properties": {
        "sliceId": { "type": "string", "minLength": 1 },
        "status": { "enum": ["captured", "not-run"] },
        "reason": { "type": "string", "minLength": 1 },
        "model": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "version"],
          "properties": {
            "name": { "type": "string", "minLength": 1 },
            "version": { "type": "string", "minLength": 1 }
          }
        },
        "tokens": {
          "type": "array",
          "items": { "$ref": "#/definitions/token" }
        },
        "notes": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "token": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "startCU", "endCU", "text", "upos", "tag", "lemma", "morphology"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "startCU": { "type": "integer", "minimum": 0 },
        "endCU": { "type": "integer", "minimum": 0 },
        "text": { "type": "string" },
        "upos": { "type": "string" },
        "tag": { "type": "string" },
        "lemma": { "type": "string" },
        "morphology": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        }
      }
    }
  }
}
