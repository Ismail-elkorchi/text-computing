{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/Ismail-elkorchi/text-computing/schemas/retrieval-expected-v1.schema.json",
  "title": "Retrieval expected output v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "taskId",
    "corpusId",
    "formula",
    "tolerance",
    "queries"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "taskId": { "const": "nlp-retrieval" },
    "corpusId": { "type": "string", "minLength": 1 },
    "formula": {
      "enum": [
        "bm25.okapi.k1-1.5.b-0.75",
        "bm25f.k1-1.2.b-0.75.fielded"
      ]
    },
    "fieldSpecs": {
      "type": "array",
      "items": { "$ref": "#/definitions/fieldSpec" }
    },
    "tolerance": { "type": "number", "minimum": 0 },
    "queries": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/query" }
    },
    "relevanceJudgments": {
      "type": "array",
      "items": { "$ref": "#/definitions/relevanceJudgment" }
    }
  },
  "definitions": {
    "fieldSpec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "source", "weight", "b"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "source": { "enum": ["tokens", "metadata"] },
        "metadataKey": { "type": "string", "minLength": 1 },
        "weight": { "type": "number", "exclusiveMinimum": 0 },
        "b": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "relevanceJudgment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["queryId", "ratings"],
      "properties": {
        "queryId": { "type": "string", "minLength": 1 },
        "ratings": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["docId", "grade"],
            "properties": {
              "docId": { "type": "string", "minLength": 1 },
              "grade": { "type": "integer", "minimum": 0 }
            }
          }
        }
      }
    },
    "query": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "raw", "tokens", "hits"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "raw": { "type": "string" },
        "tokens": {
          "type": "array",
          "items": { "type": "string" }
        },
        "hits": {
          "type": "array",
          "items": { "$ref": "#/definitions/hit" }
        }
      }
    },
    "hit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["docId", "score", "snippet", "explain"],
      "properties": {
        "docId": { "type": "string", "minLength": 1 },
        "score": { "type": "number" },
        "snippet": {
          "type": "object",
          "additionalProperties": false,
          "required": ["text", "tokenStart", "tokenEnd", "highlightedTerms"],
          "properties": {
            "text": { "type": "string" },
            "tokenStart": { "type": "integer", "minimum": 0 },
            "tokenEnd": { "type": "integer", "minimum": 0 },
            "highlightedTerms": {
              "type": "array",
              "items": { "type": "string" }
            }
          }
        },
        "explain": {
          "type": "array",
          "items": { "$ref": "#/definitions/explain" }
        }
      }
    },
    "explain": {
      "type": "object",
      "additionalProperties": false,
      "required": ["term", "tf", "df", "idf", "contribution"],
      "properties": {
        "term": { "type": "string" },
        "field": { "type": "string", "minLength": 1 },
        "tf": { "type": "number", "minimum": 0 },
        "df": { "type": "integer", "minimum": 0 },
        "idf": { "type": "number" },
        "contribution": { "type": "number" },
        "fieldContributions": {
          "type": "array",
          "items": { "$ref": "#/definitions/fieldContribution" }
        }
      }
    },
    "fieldContribution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["field", "tf", "length", "averageLength", "weight", "normalizedTf"],
      "properties": {
        "field": { "type": "string", "minLength": 1 },
        "tf": { "type": "number", "minimum": 0 },
        "length": { "type": "integer", "minimum": 0 },
        "averageLength": { "type": "number", "minimum": 0 },
        "weight": { "type": "number", "exclusiveMinimum": 0 },
        "normalizedTf": { "type": "number", "minimum": 0 }
      }
    }
  }
}
