{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/Ismail-elkorchi/text-computing/schemas/retrieval-expected-v1.schema.json",
  "title": "Retrieval expected output v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "taskId",
    "corpusId",
    "formula",
    "tolerance",
    "queries"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "taskId": { "const": "nlp-retrieval" },
    "corpusId": { "type": "string", "minLength": 1 },
    "formula": { "const": "bm25.okapi.k1-1.5.b-0.75" },
    "tolerance": { "type": "number", "minimum": 0 },
    "queries": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/query" }
    }
  },
  "definitions": {
    "query": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "raw", "tokens", "hits"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "raw": { "type": "string" },
        "tokens": {
          "type": "array",
          "items": { "type": "string" }
        },
        "hits": {
          "type": "array",
          "items": { "$ref": "#/definitions/hit" }
        }
      }
    },
    "hit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["docId", "score", "snippet", "explain"],
      "properties": {
        "docId": { "type": "string", "minLength": 1 },
        "score": { "type": "number" },
        "snippet": {
          "type": "object",
          "additionalProperties": false,
          "required": ["text", "tokenStart", "tokenEnd", "highlightedTerms"],
          "properties": {
            "text": { "type": "string" },
            "tokenStart": { "type": "integer", "minimum": 0 },
            "tokenEnd": { "type": "integer", "minimum": 0 },
            "highlightedTerms": {
              "type": "array",
              "items": { "type": "string" }
            }
          }
        },
        "explain": {
          "type": "array",
          "items": { "$ref": "#/definitions/explain" }
        }
      }
    },
    "explain": {
      "type": "object",
      "additionalProperties": false,
      "required": ["term", "tf", "df", "idf", "contribution"],
      "properties": {
        "term": { "type": "string" },
        "tf": { "type": "integer", "minimum": 0 },
        "df": { "type": "integer", "minimum": 0 },
        "idf": { "type": "number" },
        "contribution": { "type": "number" }
      }
    }
  }
}
