{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/Ismail-elkorchi/text-computing/schemas/conllu-validator-capture-v1.schema.json",
  "title": "CoNLL-U external validator capture v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "scope", "capturedDate", "validator", "dependencies", "fixtures"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "scope": { "const": "conllu-dependency" },
    "capturedDate": { "type": "string", "pattern": "^20[0-9]{2}-[0-9]{2}-[0-9]{2}$" },
    "validator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "url", "commit", "runtime", "command", "license", "artifactSurface"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "pattern": "^https://" },
        "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "runtime": { "type": "string", "minLength": 1 },
        "command": { "type": "string", "minLength": 1 },
        "license": { "type": "string", "minLength": 1 },
        "artifactSurface": { "type": "string", "minLength": 1 }
      }
    },
    "dependencies": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/dependency" }
    },
    "fixtures": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/fixtureResult" }
    },
    "notes": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "definitions": {
    "dependency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "role"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "role": { "type": "string", "minLength": 1 }
      }
    },
    "fixtureResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fixtureId", "path", "language", "expectedStatus", "exitCode", "status", "summary"],
      "properties": {
        "fixtureId": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "path": {
          "type": "string",
          "pattern": "^fixtures/conllu-dependency/(valid|invalid)/[a-z0-9-]+\\.conllu$"
        },
        "language": { "type": "string", "minLength": 2 },
        "expectedStatus": { "enum": ["pass", "fail"] },
        "exitCode": { "type": "integer", "minimum": 0 },
        "status": { "enum": ["passed-as-expected", "failed-as-expected"] },
        "summary": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
