{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/Ismail-elkorchi/text-computing/schemas/textlab-external-tool-execution-report-v1.schema.json",
  "title": "Textlab external tool execution report v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "artifactType",
    "toolId",
    "command",
    "args",
    "status",
    "timedOut",
    "durationMs",
    "stdoutLength",
    "stderrLength",
    "stdoutPreview",
    "stderrPreview",
    "stdoutTruncated",
    "stderrTruncated",
    "evidenceRefs",
    "limitations"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "artifactType": { "const": "textlab-external-tool-execution-report-v1" },
    "toolId": { "type": "string", "minLength": 1 },
    "command": { "type": "string", "minLength": 1 },
    "args": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "cwd": { "type": "string", "minLength": 1 },
    "status": { "enum": ["passed", "failed", "timed-out"] },
    "exitCode": { "type": "integer", "minimum": 0 },
    "signal": { "type": "string", "minLength": 1 },
    "failureCode": { "type": "string", "minLength": 1 },
    "timedOut": { "type": "boolean" },
    "durationMs": { "type": "number", "minimum": 0 },
    "stdoutLength": { "type": "integer", "minimum": 0 },
    "stderrLength": { "type": "integer", "minimum": 0 },
    "stdoutPreview": { "type": "string" },
    "stderrPreview": { "type": "string" },
    "stdoutTruncated": { "type": "boolean" },
    "stderrTruncated": { "type": "boolean" },
    "evidenceRefs": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
