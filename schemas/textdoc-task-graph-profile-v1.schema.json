{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/Ismail-elkorchi/text-computing/schemas/textdoc-task-graph-profile-v1.schema.json",
  "title": "textdoc task graph profile v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "profileId", "task", "evidenceRefs", "limitations"],
  "anyOf": [
    { "required": ["requiredViews"] },
    { "required": ["requiredLayers"] },
    { "required": ["annotationPatterns"] },
    { "required": ["relationArgumentRules"] },
    { "required": ["coverageRules"] }
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "profileId": { "type": "string", "minLength": 1 },
    "task": { "type": "string", "minLength": 1 },
    "requiredViews": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "kind": { "$ref": "#/definitions/viewKind" }
        }
      }
    },
    "requiredLayers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "kind": { "$ref": "#/definitions/layerKind" },
          "viewId": { "type": "string", "minLength": 1 },
          "lifecycleStates": { "$ref": "#/definitions/lifecycleStates" },
          "minAnnotations": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "annotationPatterns": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "annotationKind"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "annotationKind": { "$ref": "#/definitions/layerKind" },
          "layerId": { "type": "string", "minLength": 1 },
          "viewId": { "type": "string", "minLength": 1 },
          "lifecycleStates": { "$ref": "#/definitions/lifecycleStates" },
          "minAnnotations": { "type": "integer", "minimum": 0 },
          "requiredTargetKinds": {
            "type": "array",
            "minItems": 1,
            "items": { "$ref": "#/definitions/targetKind" }
          },
          "requiredTargetAnnotationKinds": {
            "type": "array",
            "minItems": 1,
            "items": { "$ref": "#/definitions/layerKind" }
          },
          "requiredProvenanceReferences": {
            "type": "array",
            "minItems": 1,
            "items": { "$ref": "#/definitions/referenceRef" }
          }
        }
      }
    },
    "relationArgumentRules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "requiredRoles"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "layerId": { "type": "string", "minLength": 1 },
          "viewId": { "type": "string", "minLength": 1 },
          "relationType": { "type": "string", "minLength": 1 },
          "lifecycleStates": { "$ref": "#/definitions/lifecycleStates" },
          "minRelations": { "type": "integer", "minimum": 0 },
          "requiredRoles": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["role"],
              "properties": {
                "role": { "type": "string", "minLength": 1 },
                "targetAnnotationKinds": {
                  "type": "array",
                  "minItems": 1,
                  "items": { "$ref": "#/definitions/layerKind" }
                },
                "minCount": { "type": "integer", "minimum": 0 }
              }
            }
          }
        }
      }
    },
    "coverageRules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "sourceAnnotationKind", "coveringAnnotationKind", "mode"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "sourceAnnotationKind": { "$ref": "#/definitions/layerKind" },
          "sourceLayerId": { "type": "string", "minLength": 1 },
          "sourceLifecycleStates": { "$ref": "#/definitions/lifecycleStates" },
          "coveringAnnotationKind": { "$ref": "#/definitions/layerKind" },
          "coveringLayerId": { "type": "string", "minLength": 1 },
          "coveringLifecycleStates": { "$ref": "#/definitions/lifecycleStates" },
          "mode": { "enum": ["annotation-target", "span-overlap", "span-contained"] },
          "minCoveringAnnotations": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "evidenceRefs": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/referenceRef" }
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "notes": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "definitions": {
    "viewKind": {
      "enum": ["raw", "normalized", "tailored", "task", "imported", "extension"]
    },
    "layerKind": {
      "enum": [
        "token",
        "sentence",
        "pos",
        "lemma",
        "morphology",
        "entity",
        "relation",
        "coreference-mention",
        "coreference-chain",
        "entity-link",
        "corpus-feature",
        "dependency-node",
        "dependency",
        "extension"
      ]
    },
    "targetKind": {
      "enum": ["span", "document", "annotation"]
    },
    "lifecycleStates": {
      "type": "array",
      "minItems": 1,
      "items": { "enum": ["active", "superseded", "retracted"] }
    },
    "referenceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id"],
      "properties": {
        "kind": { "type": "string", "minLength": 1 },
        "id": { "type": "string", "minLength": 1 }
      }
    }
  }
}
