{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/Ismail-elkorchi/text-computing/schemas/evidence-run-v1.schema.json",
  "title": "Evidence run v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaId",
    "schemaVersion",
    "runId",
    "taskId",
    "repo",
    "generatedAt",
    "inputs",
    "comparator",
    "command",
    "runtime",
    "environment",
    "execution",
    "status",
    "outputs",
    "differences",
    "conformanceReportRefs"
  ],
  "properties": {
    "schemaId": { "const": "urn:ismail-elkorchi:evidence:run:v1" },
    "schemaVersion": { "const": 1 },
    "runId": { "type": "string", "minLength": 1 },
    "taskId": { "type": "string", "minLength": 1 },
    "repo": { "$ref": "#/definitions/repoState" },
    "generatedAt": { "type": "string", "minLength": 1 },
    "inputs": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/artifactRef" }
    },
    "comparator": { "$ref": "#/definitions/comparator" },
    "command": { "$ref": "#/definitions/command" },
    "runtime": { "$ref": "#/definitions/runtime" },
    "environment": { "$ref": "#/definitions/environment" },
    "execution": { "$ref": "#/definitions/execution" },
    "status": { "enum": ["pass", "fail", "not-run"] },
    "outputs": {
      "type": "array",
      "items": { "$ref": "#/definitions/output" }
    },
    "differences": {
      "type": "array",
      "items": { "$ref": "#/definitions/difference" }
    },
    "conformanceReportRefs": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "notes": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "definitions": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "repoState": {
      "type": "object",
      "additionalProperties": false,
      "required": ["headSha", "dirty"],
      "properties": {
        "headSha": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "dirty": { "type": "boolean" },
        "branch": { "type": "string", "minLength": 1 },
        "remote": { "type": "string", "minLength": 1 }
      }
    },
    "artifactRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "path", "sha256"],
      "properties": {
        "role": {
          "enum": ["fixture", "expected", "source", "resource", "comparison", "schema", "report"]
        },
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/definitions/sha256" }
      }
    },
    "comparator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "runtime"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "runtime": { "type": "string", "minLength": 1 },
        "model": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "version"],
          "properties": {
            "name": { "type": "string", "minLength": 1 },
            "version": { "type": "string", "minLength": 1 }
          }
        },
        "license": { "type": "string", "minLength": 1 },
        "source": { "type": "string", "minLength": 1 }
      }
    },
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": ["argv"],
      "properties": {
        "argv": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "cwd": { "type": "string", "minLength": 1 }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "platform": { "type": "string", "minLength": 1 }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["exitCode"],
      "properties": {
        "startedAt": { "type": "string", "minLength": 1 },
        "endedAt": { "type": "string", "minLength": 1 },
        "durationMs": { "type": "integer", "minimum": 0 },
        "timeoutMs": { "type": "integer", "minimum": 0 },
        "exitCode": { "type": "integer" },
        "stdout": { "type": "string" },
        "stderr": { "type": "string" },
        "stdoutSha256": { "$ref": "#/definitions/sha256" },
        "stderrSha256": { "$ref": "#/definitions/sha256" }
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": { "type": "string", "minLength": 1 },
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/definitions/sha256" },
        "value": {}
      }
    },
    "difference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "severity", "message"],
      "properties": {
        "kind": { "type": "string", "minLength": 1 },
        "severity": { "enum": ["info", "non-failure", "failure"] },
        "message": { "type": "string", "minLength": 1 },
        "path": { "type": "string", "minLength": 1 },
        "expected": {},
        "actual": {}
      }
    }
  }
}
