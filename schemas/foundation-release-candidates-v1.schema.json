{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/Ismail-elkorchi/text-computing/schemas/foundation-release-candidates-v1.schema.json",
  "title": "Foundation release candidates v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "scope", "publicHead", "packages", "notes"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "scope": { "const": "foundation-release-candidates" },
    "publicHead": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "packages": {
      "type": "array",
      "maxItems": 4,
      "items": { "$ref": "#/definitions/package" }
    },
    "notes": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "definitions": {
    "path": {
      "type": "string",
      "minLength": 1,
      "not": {
        "anyOf": [
          { "pattern": "^/" },
          { "pattern": "\\.\\." },
          { "pattern": "\\\\" },
          { "pattern": "^https?://" }
        ]
      }
    },
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "packageName",
        "packageDir",
        "releaseTrack",
        "releaseReadiness",
        "candidateState",
        "privateRequired",
        "owns",
        "downstreamDependents",
        "requiredEvidenceRefs",
        "releaseBlockers"
      ],
      "properties": {
        "packageName": {
          "enum": [
            "@ismail-elkorchi/textprotocol",
            "@ismail-elkorchi/textconformance",
            "@ismail-elkorchi/textdoc",
            "@ismail-elkorchi/textpack"
          ]
        },
        "packageDir": {
          "enum": ["packages/textprotocol", "packages/textconformance", "packages/textdoc", "packages/textpack"]
        },
        "releaseTrack": { "const": "private-unreleased" },
        "releaseReadiness": { "const": "blocked" },
        "candidateState": {
          "enum": ["gate-defined", "api-smoke-required", "candidate-ready"]
        },
        "privateRequired": { "const": true },
        "owns": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "downstreamDependents": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "@ismail-elkorchi/textpipeline",
              "@ismail-elkorchi/textcorpus",
              "@ismail-elkorchi/textrules",
              "@ismail-elkorchi/textlab"
            ]
          }
        },
        "requiredEvidenceRefs": {
          "type": "array",
          "minItems": 4,
          "uniqueItems": true,
          "items": { "$ref": "#/definitions/path" }
        },
        "releaseBlockers": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
