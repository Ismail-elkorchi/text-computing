{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/Ismail-elkorchi/text-computing/schemas/textpack-review-report-v1.schema.json",
  "title": "textpack review report v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "packageName",
    "packId",
    "packPackageName",
    "version",
    "currentReviewState",
    "targetReviewState",
    "transition",
    "decision",
    "ok",
    "manifestOk",
    "resourceInventoryChecked",
    "resourceInventoryOk",
    "compatibilityChecked",
    "compatibilityOk",
    "resourceCount",
    "requirementCount",
    "passedRequirementCount",
    "failedRequirementCount",
    "notApplicableRequirementCount",
    "diagnosticCount",
    "evidenceRefs",
    "requirements",
    "diagnostics"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "packageName": { "const": "@ismail-elkorchi/textpack" },
    "packId": { "type": "string", "minLength": 1 },
    "packPackageName": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "currentReviewState": {
      "enum": ["experimental", "candidate", "stable", "reference", "deprecated", "unknown"]
    },
    "targetReviewState": {
      "enum": ["experimental", "candidate", "stable", "reference", "deprecated"]
    },
    "transition": {
      "enum": ["retain", "promote", "demote", "deprecate", "restore", "unavailable"]
    },
    "decision": { "enum": ["accepted", "blocked"] },
    "ok": { "type": "boolean" },
    "manifestOk": { "type": "boolean" },
    "resourceInventoryChecked": { "type": "boolean" },
    "resourceInventoryOk": { "type": "boolean" },
    "compatibilityChecked": { "type": "boolean" },
    "compatibilityOk": { "type": "boolean" },
    "resourceCount": { "type": "integer", "minimum": 0 },
    "requirementCount": { "type": "integer", "minimum": 0 },
    "passedRequirementCount": { "type": "integer", "minimum": 0 },
    "failedRequirementCount": { "type": "integer", "minimum": 0 },
    "notApplicableRequirementCount": { "type": "integer", "minimum": 0 },
    "diagnosticCount": { "type": "integer", "minimum": 0 },
    "evidenceRefs": { "$ref": "#/definitions/stringArray" },
    "requirements": {
      "type": "array",
      "items": { "$ref": "#/definitions/requirement" }
    },
    "diagnostics": {
      "type": "array",
      "items": { "$ref": "#/definitions/diagnostic" }
    }
  },
  "definitions": {
    "stringArray": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "requirement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "status", "message", "refs"],
      "properties": {
        "id": {
          "enum": [
            "manifest-governance",
            "resource-inventory",
            "compatibility-policy",
            "target-scope",
            "license-metadata",
            "provenance-metadata",
            "test-coverage",
            "limitations",
            "reviewer-evidence",
            "conformance-evidence",
            "benchmark-evidence",
            "security-evidence",
            "migration-evidence"
          ]
        },
        "status": { "enum": ["pass", "fail", "not-applicable"] },
        "message": { "type": "string", "minLength": 1 },
        "refs": { "$ref": "#/definitions/stringArray" }
      }
    },
    "diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "code", "message"],
      "properties": {
        "source": { "enum": ["manifest", "inventory", "compatibility", "evidence"] },
        "code": { "type": "string", "minLength": 1 },
        "packId": { "type": "string", "minLength": 1 },
        "resourceId": { "type": "string", "minLength": 1 },
        "family": {
          "enum": [
            "profiles",
            "rules",
            "lexicons",
            "stopwords",
            "gazetteers",
            "tagsets",
            "morphology",
            "transducers",
            "structures",
            "benchmarks"
          ]
        },
        "path": { "type": "string", "minLength": 1 },
        "ref": { "type": "string", "minLength": 1 },
        "message": { "type": "string", "minLength": 1 }
      }
    }
  }
}
