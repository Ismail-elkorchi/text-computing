{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/Ismail-elkorchi/text-computing/schemas/relation-extraction-expected-v1.schema.json",
  "title": "Relation extraction expected output v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "taskId", "sliceId", "relations"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "taskId": { "const": "nlp-relation-extraction" },
    "sliceId": { "type": "string", "minLength": 1 },
    "relations": {
      "type": "array",
      "items": { "$ref": "#/definitions/relation" }
    }
  },
  "definitions": {
    "relation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "arguments", "evidence"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "label": {
          "enum": ["employed-by", "located-in", "part-of", "no-relation"]
        },
        "arguments": {
          "type": "array",
          "minItems": 2,
          "items": { "$ref": "#/definitions/argument" }
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/span" }
        },
        "diagnostics": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "argument": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "target"],
      "properties": {
        "role": { "type": "string", "minLength": 1 },
        "target": { "$ref": "#/definitions/span" }
      }
    },
    "span": {
      "type": "object",
      "additionalProperties": false,
      "required": ["startCU", "endCU"],
      "properties": {
        "startCU": { "type": "integer", "minimum": 0 },
        "endCU": { "type": "integer", "minimum": 0 },
        "text": { "type": "string" }
      }
    }
  }
}
