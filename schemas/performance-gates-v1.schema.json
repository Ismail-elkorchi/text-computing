{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/Ismail-elkorchi/text-computing/schemas/performance-gates-v1.schema.json",
  "title": "Performance gates v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "scope", "status", "gates"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "scope": { "const": "performance-gates" },
    "status": { "const": "thresholds-defined" },
    "gates": {
      "type": "array",
      "minItems": 5,
      "items": { "$ref": "#/definitions/gate" }
    },
    "notes": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "definitions": {
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "packageName",
        "surface",
        "dimensions",
        "scalePolicy",
        "regressionPolicy",
        "evidenceRefs",
        "limitations"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "packageName": { "type": "string", "pattern": "^@ismail-elkorchi/[a-z]+$" },
        "surface": { "type": "string", "minLength": 1 },
        "dimensions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "throughput",
              "memory",
              "streaming",
              "large-corpus",
              "regression-threshold"
            ]
          }
        },
        "scalePolicy": { "type": "string", "minLength": 1 },
        "regressionPolicy": { "type": "string", "minLength": 1 },
        "thresholds": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "minDocuments": { "type": "integer", "minimum": 1 },
            "minTokens": { "type": "integer", "minimum": 1 },
            "minQueries": { "type": "integer", "minimum": 1 },
            "maxSerializedIndexBytes": { "type": "integer", "minimum": 1 }
          },
          "minProperties": 1
        },
        "evidenceRefs": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "limitations": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
