{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/Ismail-elkorchi/text-computing/schemas/textpack-manifest-v1.schema.json",
  "title": "textpack manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manifestVersion",
    "id",
    "packageName",
    "version",
    "kind",
    "targets",
    "engines",
    "externalData",
    "capabilities",
    "resources",
    "provides",
    "entrypoints",
    "licenses",
    "provenance",
    "tests",
    "reviewState"
  ],
  "properties": {
    "manifestVersion": { "const": "1.0.0" },
    "id": { "type": "string", "pattern": "^pack:[a-z0-9][a-z0-9._-]*$" },
    "packageName": { "type": "string", "pattern": "^@ismail-elkorchi/textpack-[a-z0-9][a-z0-9-]*$" },
    "version": { "type": "string", "minLength": 1 },
    "kind": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": ["profile", "language", "morph", "domain", "historical", "structure", "composite"]
      }
    },
    "targets": { "$ref": "#/definitions/targets" },
    "engines": { "$ref": "#/definitions/stringMap" },
    "externalData": { "$ref": "#/definitions/stringMap" },
    "capabilities": { "$ref": "#/definitions/capabilities" },
    "resources": { "$ref": "#/definitions/resourceFamilyMap" },
    "provides": { "$ref": "#/definitions/resourceFamilyMap" },
    "entrypoints": { "$ref": "#/definitions/entrypoints" },
    "licenses": { "$ref": "#/definitions/licenses" },
    "provenance": { "$ref": "#/definitions/provenance" },
    "tests": { "$ref": "#/definitions/tests" },
    "reviewState": {
      "enum": ["experimental", "candidate", "stable", "reference", "deprecated"]
    },
    "composition": { "$ref": "#/definitions/composition" },
    "limitations": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "notes": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "definitions": {
    "nonEmptyStringArray": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "stringMap": {
      "type": "object",
      "additionalProperties": { "type": "string", "minLength": 1 }
    },
    "targets": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "languages": { "$ref": "#/definitions/nonEmptyStringArray" },
        "scripts": { "$ref": "#/definitions/nonEmptyStringArray" },
        "regions": { "$ref": "#/definitions/nonEmptyStringArray" },
        "periods": { "$ref": "#/definitions/nonEmptyStringArray" },
        "domains": { "$ref": "#/definitions/nonEmptyStringArray" },
        "genres": { "$ref": "#/definitions/nonEmptyStringArray" },
        "profiles": { "$ref": "#/definitions/nonEmptyStringArray" }
      }
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "profiles": { "$ref": "#/definitions/capabilityValue" },
        "rules": { "$ref": "#/definitions/capabilityValue" },
        "lexicons": { "$ref": "#/definitions/capabilityValue" },
        "stopwords": { "$ref": "#/definitions/capabilityValue" },
        "gazetteers": { "$ref": "#/definitions/capabilityValue" },
        "tagsets": { "$ref": "#/definitions/capabilityValue" },
        "morphology": { "$ref": "#/definitions/capabilityValue" },
        "transducers": { "$ref": "#/definitions/capabilityValue" },
        "structures": { "$ref": "#/definitions/capabilityValue" },
        "benchmarks": { "$ref": "#/definitions/capabilityValue" }
      }
    },
    "capabilityValue": {
      "anyOf": [{ "type": "boolean" }, { "type": "string", "minLength": 1 }]
    },
    "resourceFamilyMap": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "profiles": { "$ref": "#/definitions/nonEmptyStringArray" },
        "rules": { "$ref": "#/definitions/nonEmptyStringArray" },
        "lexicons": { "$ref": "#/definitions/nonEmptyStringArray" },
        "stopwords": { "$ref": "#/definitions/nonEmptyStringArray" },
        "gazetteers": { "$ref": "#/definitions/nonEmptyStringArray" },
        "tagsets": { "$ref": "#/definitions/nonEmptyStringArray" },
        "morphology": { "$ref": "#/definitions/nonEmptyStringArray" },
        "transducers": { "$ref": "#/definitions/nonEmptyStringArray" },
        "structures": { "$ref": "#/definitions/nonEmptyStringArray" },
        "benchmarks": { "$ref": "#/definitions/nonEmptyStringArray" }
      }
    },
    "entrypoints": {
      "type": "object",
      "additionalProperties": false,
      "required": ["manifest"],
      "properties": {
        "manifest": { "type": "string", "minLength": 1 },
        "load": { "type": "string", "minLength": 1 }
      }
    },
    "licenses": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "data"],
      "properties": {
        "code": { "$ref": "#/definitions/nonEmptyStringArray" },
        "data": { "$ref": "#/definitions/nonEmptyStringArray" },
        "notices": { "$ref": "#/definitions/nonEmptyStringArray" }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sources", "generated"],
      "properties": {
        "sources": { "$ref": "#/definitions/nonEmptyStringArray" },
        "generated": { "type": "boolean" },
        "createdBy": { "$ref": "#/definitions/nonEmptyStringArray" },
        "notes": { "$ref": "#/definitions/nonEmptyStringArray" }
      }
    },
    "tests": {
      "type": "object",
      "additionalProperties": false,
      "required": ["smoke", "negative", "representative"],
      "properties": {
        "smoke": { "$ref": "#/definitions/nonEmptyStringArray" },
        "negative": { "$ref": "#/definitions/nonEmptyStringArray" },
        "representative": { "$ref": "#/definitions/nonEmptyStringArray" }
      }
    },
    "composition": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "overlayPrecedence": { "type": "integer", "minimum": 0 },
        "exclusiveWith": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^pack:[a-z0-9][a-z0-9._-]*$" }
        }
      }
    }
  }
}
