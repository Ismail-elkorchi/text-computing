{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/Ismail-elkorchi/text-computing/schemas/conllu-dependency-slices-v1.schema.json",
  "title": "CoNLL-U dependency readiness slices v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "scope",
    "conlluVersion",
    "supportStatus",
    "expectedRoundTripStatus",
    "fixtures"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "scope": { "const": "conllu-dependency" },
    "conlluVersion": { "const": "UD-v2-CoNLL-U" },
    "supportStatus": {
      "enum": ["readiness-only", "slice-proven"]
    },
    "expectedRoundTripStatus": {
      "enum": ["planned", "recorded"]
    },
    "fixtures": {
      "type": "object",
      "additionalProperties": false,
      "required": ["valid", "invalid"],
      "properties": {
        "valid": {
          "type": "array",
          "minItems": 2,
          "items": { "$ref": "#/definitions/validFixture" }
        },
        "invalid": {
          "type": "array",
          "minItems": 3,
          "items": { "$ref": "#/definitions/invalidFixture" }
        }
      }
    }
  },
  "definitions": {
    "fixturePath": {
      "type": "string",
      "pattern": "^fixtures/conllu-dependency/(valid|invalid)/[a-z0-9-]+\\.conllu$"
    },
    "phenomenon": {
      "enum": [
        "basic-dependency-tree",
        "root-arc",
        "punctuation-arc",
        "multiword-token",
        "morphological-features",
        "non-english-latin-script",
        "enhanced-dependencies"
      ]
    },
    "validFixture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "path",
        "language",
        "phenomena",
        "expectedPath",
        "roundTripPlan"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$"
        },
        "path": { "$ref": "#/definitions/fixturePath" },
        "expectedPath": {
          "type": "string",
          "pattern": "^fixtures/conllu-dependency/expected/[a-z0-9-]+\\.json$"
        },
        "language": {
          "type": "string",
          "minLength": 2
        },
        "phenomena": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/definitions/phenomenon" }
        },
        "roundTripPlan": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "import",
            "export",
            "annotationContract"
          ],
          "properties": {
            "import": { "const": "planned" },
            "export": { "const": "planned" },
            "annotationContract": { "const": "textdoc-dependency-target-v1" }
          }
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "invalidFixture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "path",
        "reason",
        "mustFail"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$"
        },
        "path": { "$ref": "#/definitions/fixturePath" },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "mustFail": {
          "enum": [
            "dangling-head",
            "root-count",
            "field-count"
          ]
        }
      }
    }
  }
}
