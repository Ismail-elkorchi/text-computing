{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/Ismail-elkorchi/text-computing/schemas/relation-extraction-slices-v1.schema.json",
  "title": "Relation extraction readiness slices v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "taskId",
    "expectedOutputStatus",
    "comparatorStatus",
    "allowedFixturePolicy",
    "corpusEvidence",
    "relationLabelPolicy",
    "fixtures",
    "negativeControls"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "taskId": {
      "const": "nlp-relation-extraction"
    },
    "expectedOutputStatus": {
      "enum": [
        "schema-defined",
        "recorded"
      ]
    },
    "comparatorStatus": {
      "const": "claim-downgraded"
    },
    "allowedFixturePolicy": {
      "type": "string",
      "minLength": 1
    },
    "corpusEvidence": {
      "$ref": "#/definitions/corpusEvidence"
    },
    "relationLabelPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "labels",
        "argumentPolicy",
        "evidencePolicy"
      ],
      "properties": {
        "labels": {
          "type": "array",
          "minItems": 3,
          "uniqueItems": true,
          "items": {
            "enum": [
              "employed-by",
              "located-in",
              "part-of",
              "no-relation"
            ]
          }
        },
        "argumentPolicy": {
          "type": "string",
          "minLength": 1
        },
        "evidencePolicy": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "fixtures": {
      "type": "array",
      "minItems": 4,
      "items": {
        "$ref": "#/definitions/fixture"
      }
    },
    "negativeControls": {
      "type": "array",
      "minItems": 2,
      "items": {
        "$ref": "#/definitions/negativeControl"
      }
    }
  },
  "definitions": {
    "corpusEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "status",
        "corpusClass",
        "splitPolicy",
        "supportBoundary",
        "documents"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9:-]+$"
        },
        "status": {
          "const": "committed"
        },
        "corpusClass": {
          "const": "repository-authored-evaluation-slice"
        },
        "splitPolicy": {
          "type": "string",
          "minLength": 1
        },
        "supportBoundary": {
          "type": "string",
          "minLength": 1
        },
        "documents": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/definitions/corpusDocument"
          }
        }
      }
    },
    "corpusDocument": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fixtureId",
        "expectedPath",
        "sourceSha256",
        "role"
      ],
      "properties": {
        "fixtureId": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$"
        },
        "expectedPath": {
          "type": "string",
          "minLength": 1
        },
        "sourceSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "role": {
          "enum": [
            "evaluation",
            "negative-control"
          ]
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "text"
      ],
      "properties": {
        "kind": {
          "const": "text"
        },
        "text": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "fixture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "language",
        "script",
        "fixtureClass",
        "phenomena",
        "source"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$"
        },
        "language": {
          "type": "string",
          "minLength": 2
        },
        "script": {
          "type": "string",
          "minLength": 4
        },
        "fixtureClass": {
          "enum": [
            "repository-authored",
            "public-domain",
            "cc0-compatible"
          ]
        },
        "phenomena": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "intra-sentence-relation",
              "cross-sentence-evidence",
              "prepositional-cue",
              "appositive-cue",
              "negated-relation",
              "cooccurrence-control",
              "non-english-latin-script",
              "non-latin-script",
              "right-to-left-script"
            ]
          }
        },
        "source": {
          "$ref": "#/definitions/source"
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "negativeControl": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "expectedFailure"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$"
        },
        "expectedFailure": {
          "enum": [
            "cooccurrence-without-relation",
            "negated-relation",
            "missing-argument",
            "ambiguous-attachment"
          ]
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
