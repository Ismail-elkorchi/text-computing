{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/Ismail-elkorchi/text-computing/schemas/pos-morph-lemma-corpus-evaluation-v1.schema.json",
  "title": "POS, morphology, and lemma corpus evaluation v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "taskId",
    "evaluationId",
    "scopeBoundary",
    "documents",
    "limitations"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "taskId": { "const": "nlp-pos-morph-lemma" },
    "evaluationId": { "type": "string", "minLength": 1 },
    "scopeBoundary": { "type": "string", "minLength": 1 },
    "documents": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/document" }
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "definitions": {
    "document": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "sourceSliceId",
        "expectedOutputRef",
        "splitRole",
        "language",
        "phenomena",
        "goldTokens"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "sourceSliceId": { "type": "string", "minLength": 1 },
        "expectedOutputRef": {
          "type": "string",
          "pattern": "^fixtures/pos-morph-lemma/expected/[^/]+\\.json$"
        },
        "splitRole": { "enum": ["development", "validation", "holdout", "negative-control"] },
        "language": { "type": "string", "minLength": 1 },
        "phenomena": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "goldTokens": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/goldToken" }
        }
      }
    },
    "goldToken": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tokenId", "text", "acceptedUpos", "acceptedLemmas"],
      "properties": {
        "tokenId": { "type": "string", "minLength": 1 },
        "text": { "type": "string" },
        "acceptedUpos": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "acceptedLemmas": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "requiredMorphologyAlternatives": {
          "type": "array",
          "items": {
            "type": "array",
            "items": { "$ref": "#/definitions/morphFeature" }
          }
        },
        "notes": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "morphFeature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "value"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "value": { "type": "string", "minLength": 1 }
      }
    }
  }
}
