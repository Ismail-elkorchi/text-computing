{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/Ismail-elkorchi/text-computing/schemas/textprotocol-registry-manifest-v1.schema.json",
  "title": "textprotocol registry manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "producer",
    "resultEnvelope",
    "schemaFamilyEnvelope",
    "payloadKinds",
    "schemaFamilies",
    "summary",
    "limitations"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "producer": { "$ref": "#/definitions/producer" },
    "resultEnvelope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaId", "supportedVersions", "jsonMediaType"],
      "properties": {
        "schemaId": { "const": "urn:ismail-elkorchi:textprotocol:result-envelope:v1" },
        "supportedVersions": {
          "type": "array",
          "minItems": 1,
          "items": { "const": 1 },
          "uniqueItems": true
        },
        "jsonMediaType": {
          "const": "application/vnd.ismail-elkorchi.textprotocol.result-envelope.v1+json"
        }
      }
    },
    "schemaFamilyEnvelope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "jsonMediaType", "registeredFamilies"],
      "properties": {
        "schemaVersion": { "const": 1 },
        "jsonMediaType": {
          "const": "application/vnd.ismail-elkorchi.textprotocol.schema-family-envelope.v1+json"
        },
        "registeredFamilies": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/schemaFamily" },
          "uniqueItems": true
        }
      }
    },
    "payloadKinds": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/payloadKindDescriptor" }
    },
    "schemaFamilies": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/schemaFamilyDescriptor" }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "payloadKindCount",
        "schemaFamilyCount",
        "protocolOwnedSchemaFamilyCount",
        "externallyOwnedSchemaFamilyCount",
        "schemaPathCount"
      ],
      "properties": {
        "payloadKindCount": { "type": "integer", "minimum": 0 },
        "schemaFamilyCount": { "type": "integer", "minimum": 0 },
        "protocolOwnedSchemaFamilyCount": { "type": "integer", "minimum": 0 },
        "externallyOwnedSchemaFamilyCount": { "type": "integer", "minimum": 0 },
        "schemaPathCount": { "type": "integer", "minimum": 0 }
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "definitions": {
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["package", "version"],
      "properties": {
        "package": { "const": "@ismail-elkorchi/textprotocol" },
        "version": { "type": "string", "minLength": 1 }
      }
    },
    "payloadKind": {
      "enum": [
        "textdoc-document-v1",
        "textpipeline-trace-v1",
        "textpipeline-batch-run-report-v1",
        "textconformance-report-v1",
        "public-vertical-slice-0.1-result-v1"
      ]
    },
    "schemaFamily": {
      "enum": [
        "pack-manifest",
        "document-bundle",
        "annotation-bundle",
        "evidence-bundle",
        "result-envelope",
        "processor-trace",
        "corpus-metric-envelope",
        "mapping-loss-report",
        "protocol-error"
      ]
    },
    "payloadKindDescriptor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["payloadKind", "ownerPackage", "description"],
      "properties": {
        "payloadKind": { "$ref": "#/definitions/payloadKind" },
        "ownerPackage": { "type": "string", "minLength": 1 },
        "schemaId": { "type": "string", "minLength": 1 },
        "schemaVersion": {
          "anyOf": [
            { "type": "string", "minLength": 1 },
            { "type": "number" }
          ]
        },
        "description": { "type": "string", "minLength": 1 }
      }
    },
    "schemaFamilyDescriptor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "family",
        "schemaId",
        "schemaVersion",
        "ownerPackage",
        "schemaPath",
        "description"
      ],
      "properties": {
        "family": { "$ref": "#/definitions/schemaFamily" },
        "schemaId": { "type": "string", "minLength": 1 },
        "schemaVersion": { "const": 1 },
        "ownerPackage": { "type": "string", "minLength": 1 },
        "schemaPath": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 }
      }
    }
  }
}
