{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "corpus-tfidf-bm25-slices-v1.schema.json",
  "title": "Corpus TF-IDF/BM25 readiness slices v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "taskId",
    "expectedOutputStatus",
    "corpora"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "taskId": {
      "const": "nlp-corpus-tfidf-bm25"
    },
    "expectedOutputStatus": {
      "const": "recorded"
    },
    "corpora": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "description",
          "tokenPolicy",
          "phenomena",
          "documents",
          "queries"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "tokenPolicy": {
            "type": "string",
            "minLength": 1
          },
          "role": {
            "enum": [
              "development",
              "validation",
              "holdout",
              "negative-control"
            ]
          },
          "phenomena": {
            "type": "array",
            "minItems": 1,
            "items": {
              "enum": [
                "repeated-term",
                "shared-term",
                "singleton-term",
                "empty-document",
                "missing-query-term",
                "stable-ordering",
                "larger-corpus",
                "formula-variant",
                "numeric-tolerance",
                "performance-threshold",
                "held-out-corpus",
                "public-domain-source"
              ]
            }
          },
          "license": {
            "type": "string",
            "minLength": 1
          },
          "provenance": {
            "type": "string",
            "minLength": 1
          },
          "contentHash": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "performanceThresholds": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "minDocuments",
              "minTokens",
              "minQueries",
              "maxSerializedScoringBytes"
            ],
            "properties": {
              "minDocuments": {
                "type": "integer",
                "minimum": 1
              },
              "minTokens": {
                "type": "integer",
                "minimum": 1
              },
              "minQueries": {
                "type": "integer",
                "minimum": 1
              },
              "maxSerializedScoringBytes": {
                "type": "integer",
                "minimum": 1
              }
            }
          },
          "documents": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "tokens"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "tokens": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "metadata": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "string"
                  }
                }
              }
            }
          },
          "queries": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "tokens"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "tokens": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
