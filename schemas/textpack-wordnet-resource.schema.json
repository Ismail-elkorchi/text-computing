{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/Ismail-elkorchi/text-computing/schemas/textpack-wordnet-resource.schema.json",
  "title": "TextpackWordNetResource",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "kind", "lexicalEntries", "senses", "synsets", "relations"],
  "properties": {
    "schemaVersion": { "const": "1" },
    "kind": { "const": "wordnet" },
    "lexicalEntries": {
      "type": "array",
      "items": { "$ref": "#/definitions/lexicalEntry" }
    },
    "senses": {
      "type": "array",
      "items": { "$ref": "#/definitions/sense" }
    },
    "synsets": {
      "type": "array",
      "items": { "$ref": "#/definitions/synset" }
    },
    "relations": {
      "type": "array",
      "items": { "$ref": "#/definitions/relation" }
    }
  },
  "definitions": {
    "lexicalEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entryId", "lemma", "partOfSpeech"],
      "properties": {
        "entryId": { "type": "string", "minLength": 1 },
        "lemma": { "type": "string", "minLength": 1 },
        "partOfSpeech": { "type": "string" }
      }
    },
    "sense": {
      "type": "object",
      "additionalProperties": false,
      "required": ["senseId", "entryId", "lemma", "partOfSpeech", "synsetId"],
      "properties": {
        "senseId": { "type": "string", "minLength": 1 },
        "entryId": { "type": "string", "minLength": 1 },
        "lemma": { "type": "string", "minLength": 1 },
        "partOfSpeech": { "type": "string" },
        "synsetId": { "type": "string", "minLength": 1 },
        "subcat": { "type": "string" }
      }
    },
    "synset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["synsetId", "partOfSpeech", "members"],
      "properties": {
        "synsetId": { "type": "string", "minLength": 1 },
        "ili": { "type": "string" },
        "partOfSpeech": { "type": "string" },
        "lexfile": { "type": "string" },
        "members": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "definition": { "type": "string" },
        "exampleCount": { "type": "integer", "minimum": 0 }
      }
    },
    "relation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scope", "sourceId", "relType", "targetId"],
      "properties": {
        "scope": { "enum": ["sense", "synset"] },
        "sourceId": { "type": "string", "minLength": 1 },
        "relType": { "type": "string", "minLength": 1 },
        "targetId": { "type": "string", "minLength": 1 }
      }
    }
  }
}
