{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "textpack-catalog-v1.schema.json",
  "title": "textpack catalog v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "packageName",
    "packCount",
    "resourceCount",
    "languages",
    "profiles",
    "reviewStates",
    "packs",
    "resourcesByFamily"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "packageName": { "const": "@ismail-elkorchi/textpack" },
    "packCount": { "type": "integer", "minimum": 0 },
    "resourceCount": { "type": "integer", "minimum": 0 },
    "languages": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "profiles": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "reviewStates": {
      "type": "array",
      "items": {
        "enum": ["experimental", "candidate", "stable", "reference", "deprecated"]
      }
    },
    "packs": {
      "type": "array",
      "items": { "$ref": "#/definitions/packSummary" }
    },
    "resourcesByFamily": {
      "type": "array",
      "items": { "$ref": "#/definitions/familySummary" }
    }
  },
  "definitions": {
    "stringArray": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "resourceFamily": {
      "enum": [
        "profiles",
        "rules",
        "lexicons",
        "stopwords",
        "gazetteers",
        "tagsets",
        "morphology",
        "transducers",
        "structures",
        "benchmarks"
      ]
    },
    "packSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "packageName",
        "version",
        "reviewState",
        "languages",
        "profiles",
        "resourceCount",
        "resourceFamilies",
        "resourceIds",
        "licenses",
        "provenance",
        "tests"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^pack:[a-z0-9][a-z0-9._-]*$" },
        "packageName": { "type": "string", "pattern": "^@ismail-elkorchi/textpack-[a-z0-9][a-z0-9-]*$" },
        "version": { "type": "string", "minLength": 1 },
        "reviewState": {
          "enum": ["experimental", "candidate", "stable", "reference", "deprecated"]
        },
        "languages": { "$ref": "#/definitions/stringArray" },
        "profiles": { "$ref": "#/definitions/stringArray" },
        "resourceCount": { "type": "integer", "minimum": 0 },
        "resourceFamilies": {
          "type": "array",
          "items": { "$ref": "#/definitions/resourceFamily" }
        },
        "resourceIds": { "$ref": "#/definitions/stringArray" },
        "licenses": {
          "type": "object",
          "additionalProperties": true
        },
        "provenance": {
          "type": "object",
          "additionalProperties": true
        },
        "tests": {
          "type": "object",
          "additionalProperties": true
        },
        "limitations": { "$ref": "#/definitions/stringArray" }
      }
    },
    "familySummary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["family", "resourceCount", "resourceIds"],
      "properties": {
        "family": { "$ref": "#/definitions/resourceFamily" },
        "resourceCount": { "type": "integer", "minimum": 0 },
        "resourceIds": { "$ref": "#/definitions/stringArray" }
      }
    }
  }
}
