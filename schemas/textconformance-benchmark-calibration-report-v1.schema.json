{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/Ismail-elkorchi/text-computing/schemas/textconformance-benchmark-calibration-report-v1.schema.json",
  "title": "Textconformance benchmark calibration report v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "artifactType",
    "calibrationId",
    "benchmarkId",
    "subject",
    "generatedAt",
    "hostCount",
    "metricCount",
    "summary",
    "hosts",
    "rows",
    "evidenceRefs",
    "limitations"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "artifactType": { "const": "textconformance-benchmark-calibration-report-v1" },
    "calibrationId": { "type": "string", "minLength": 1 },
    "benchmarkId": { "type": "string", "minLength": 1 },
    "subject": { "$ref": "#/definitions/subject" },
    "generatedAt": { "type": "string", "minLength": 1 },
    "hostCount": { "type": "integer", "minimum": 2 },
    "metricCount": { "type": "integer", "minimum": 0 },
    "baselineHostId": { "type": "string", "minLength": 1 },
    "maxRelativeSpread": { "type": "number" },
    "summary": { "$ref": "#/definitions/summary" },
    "hosts": {
      "type": "array",
      "items": { "$ref": "#/definitions/host" }
    },
    "rows": {
      "type": "array",
      "items": { "$ref": "#/definitions/row" }
    },
    "evidenceRefs": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "notes": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "definitions": {
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id"],
      "properties": {
        "kind": { "type": "string", "minLength": 1 },
        "id": { "type": "string", "minLength": 1 },
        "schemaId": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 }
      }
    },
    "host": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hostId"],
      "properties": {
        "hostId": { "type": "string", "minLength": 1 },
        "label": { "type": "string", "minLength": 1 },
        "runtime": { "type": "string", "minLength": 1 },
        "os": { "type": "string", "minLength": 1 },
        "arch": { "type": "string", "minLength": 1 },
        "evidenceRefs": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "hostValue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hostId", "value", "generatedAt", "evidenceRefs"],
      "properties": {
        "hostId": { "type": "string", "minLength": 1 },
        "value": { "type": "number" },
        "generatedAt": { "type": "string", "minLength": 1 },
        "evidenceRefs": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "metricId",
        "unit",
        "status",
        "hostCount",
        "observedHostCount",
        "missingHostIds",
        "min",
        "max",
        "mean",
        "median",
        "relativeSpread",
        "hostValues"
      ],
      "properties": {
        "metricId": { "type": "string", "minLength": 1 },
        "unit": { "type": "string", "minLength": 1 },
        "higherIsPreferred": { "type": "boolean" },
        "status": { "enum": ["observed", "stable", "variable", "incomplete"] },
        "hostCount": { "type": "integer", "minimum": 2 },
        "observedHostCount": { "type": "integer", "minimum": 1 },
        "missingHostIds": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "min": { "type": "number" },
        "max": { "type": "number" },
        "mean": { "type": "number" },
        "median": { "type": "number" },
        "relativeSpread": { "type": ["number", "null"] },
        "baselineHostId": { "type": "string", "minLength": 1 },
        "baselineValue": { "type": "number" },
        "baselineDelta": { "type": "number" },
        "baselineRatio": { "type": ["number", "null"] },
        "hostValues": {
          "type": "array",
          "items": { "$ref": "#/definitions/hostValue" }
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["observed", "stable", "variable", "incomplete"],
      "properties": {
        "observed": { "type": "integer", "minimum": 0 },
        "stable": { "type": "integer", "minimum": 0 },
        "variable": { "type": "integer", "minimum": 0 },
        "incomplete": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
