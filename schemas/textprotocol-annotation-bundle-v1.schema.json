{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/Ismail-elkorchi/text-computing/schemas/textprotocol-annotation-bundle-v1.schema.json",
  "title": "textprotocol annotation bundle v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaId", "schemaVersion", "producer", "payload"],
  "properties": {
    "schemaId": { "const": "urn:ismail-elkorchi:textprotocol:annotation-bundle:v1" },
    "schemaVersion": { "const": 1 },
    "producer": { "$ref": "#/definitions/producer" },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["documentId", "documentRevision", "annotations"],
      "properties": {
        "documentId": { "type": "string", "minLength": 1 },
        "documentRevision": { "type": "string", "minLength": 1 },
        "annotations": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["annotationId", "layerId", "kind", "target", "annotation"],
            "properties": {
              "annotationId": { "type": "string", "minLength": 1 },
              "layerId": { "type": "string", "minLength": 1 },
              "kind": { "type": "string", "minLength": 1 },
              "target": { "$ref": "#/definitions/target" },
              "annotation": { "type": "object" }
            }
          }
        }
      }
    },
    "provenance": { "$ref": "#/definitions/provenance" },
    "diagnostics": { "$ref": "#/definitions/diagnostics" },
    "limitations": { "$ref": "#/definitions/nonEmptyStringArray" },
    "extensions": { "type": "object" }
  },
  "definitions": {
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["package", "version"],
      "properties": {
        "package": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": { "type": "string", "minLength": 1 },
        "documentId": { "type": "string", "minLength": 1 },
        "viewId": { "type": "string", "minLength": 1 },
        "annotationId": { "type": "string", "minLength": 1 },
        "externalDocumentId": { "type": "string", "minLength": 1 },
        "startCU": { "type": "integer", "minimum": 0 },
        "endCU": { "type": "integer", "minimum": 0 }
      }
    },
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id"],
      "properties": {
        "kind": { "type": "string", "minLength": 1 },
        "id": { "type": "string", "minLength": 1 }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id"],
          "properties": {
            "id": { "type": "string", "minLength": 1 },
            "sha256": { "type": "string", "minLength": 1 }
          }
        },
        "references": { "type": "array", "items": { "$ref": "#/definitions/reference" } }
      }
    },
    "diagnostics": { "type": "array", "items": { "$ref": "#/definitions/diagnostic" } },
    "diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "severity"],
      "properties": {
        "code": { "type": "string", "minLength": 1 },
        "severity": { "enum": ["info", "warning", "error"] },
        "message": { "type": "string", "minLength": 1 }
      }
    },
    "nonEmptyStringArray": { "type": "array", "items": { "type": "string", "minLength": 1 } }
  }
}
