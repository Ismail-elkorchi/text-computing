{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/Ismail-elkorchi/text-computing/schemas/textdoc-dependency-target-v1.schema.json",
  "title": "textdoc dependency target contract v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "scope",
    "targetUnit",
    "sourceFormat",
    "dependencies"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "scope": { "const": "textdoc-dependency-target" },
    "targetUnit": { "const": "token" },
    "sourceFormat": { "const": "conllu" },
    "dependencies": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/dependency" }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "definitions": {
    "dependency": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "dependentTokenId",
        "headTokenId",
        "relation",
        "source"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "dependentTokenId": {
          "type": "string",
          "minLength": 1
        },
        "headTokenId": {
          "type": ["string", "null"]
        },
        "relation": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_:.-]*$"
        },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "sentenceId",
            "conlluId",
            "conlluHead",
            "conlluDeprel"
          ],
          "properties": {
            "sentenceId": {
              "type": "string",
              "minLength": 1
            },
            "conlluId": {
              "type": "string",
              "minLength": 1
            },
            "conlluHead": {
              "type": "string",
              "pattern": "^[0-9]+$"
            },
            "conlluDeprel": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_:.-]*$"
            }
          }
        }
      }
    }
  }
}
