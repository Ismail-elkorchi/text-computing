{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/Ismail-elkorchi/text-computing/schemas/multilingual-coverage-v1.schema.json",
  "title": "multilingual coverage v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "scope",
    "externalReference",
    "coverageAxes",
    "coverageLevels",
    "scriptFixtures"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "scope": {
      "const": "multilingual-support"
    },
    "externalReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version",
        "releaseDate",
        "treebanks",
        "languages",
        "sourceRefs"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "releaseDate": {
          "type": "string",
          "minLength": 1
        },
        "treebanks": {
          "type": "integer",
          "minimum": 1
        },
        "languages": {
          "type": "integer",
          "minimum": 1
        },
        "sourceRefs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "coverageAxes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scripts",
        "families",
        "morphologyProfiles",
        "interpretation"
      ],
      "properties": {
        "scripts": {
          "type": "array",
          "minItems": 15,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "families": {
          "type": "array",
          "minItems": 8,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "morphologyProfiles": {
          "type": "array",
          "minItems": 4,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "interpretation": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "scriptFixtures": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/definitions/scriptFixture"
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "coverageLevels": {
      "type": "array",
      "minItems": 4,
      "items": {
        "$ref": "#/definitions/tier"
      }
    }
  },
  "definitions": {
    "tierName": {
      "enum": [
        "unicode-invariant",
        "fixture-proven",
        "resource-backed",
        "corpus-backed"
      ]
    },
    "tier": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "status",
        "definition",
        "claimBoundary",
        "evidenceRefs",
        "limitations"
      ],
      "properties": {
        "name": {
          "$ref": "#/definitions/tierName"
        },
        "status": {
          "enum": [
            "present",
            "partial",
            "gap"
          ]
        },
        "definition": {
          "type": "string",
          "minLength": 1
        },
        "claimBoundary": {
          "type": "string",
          "minLength": 1
        },
        "evidenceRefs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "limitations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "scriptFixture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "language",
        "script",
        "direction",
        "fixtureRole",
        "inputPath",
        "sha256",
        "evidenceRefs",
        "limitations"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "language": {
          "type": "string",
          "minLength": 2
        },
        "script": {
          "type": "string",
          "minLength": 1
        },
        "direction": {
          "enum": [
            "ltr",
            "rtl",
            "mixed"
          ]
        },
        "inputPath": {
          "type": "string",
          "pattern": "^fixtures/multilingual-support/inputs/[a-z0-9-]+\\.txt$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "evidenceRefs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "limitations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "fixtureRole": {
          "enum": [
            "behavior-fixture",
            "coverage-seed"
          ]
        }
      }
    }
  }
}
