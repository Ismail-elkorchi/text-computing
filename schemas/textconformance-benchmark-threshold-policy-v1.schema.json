{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/Ismail-elkorchi/text-computing/schemas/textconformance-benchmark-threshold-policy-v1.schema.json",
  "title": "textconformance benchmark threshold policy v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "policyId",
    "benchmarkId",
    "subject",
    "calibratedAt",
    "thresholds",
    "evidenceRefs",
    "limitations"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "policyId": { "type": "string", "minLength": 1 },
    "benchmarkId": { "type": "string", "minLength": 1 },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id"],
      "properties": {
        "kind": { "type": "string", "minLength": 1 },
        "id": { "type": "string", "minLength": 1 },
        "schemaId": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 }
      }
    },
    "calibratedAt": { "type": "string", "minLength": 1 },
    "thresholds": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["metricId"],
        "anyOf": [
          { "required": ["min"] },
          { "required": ["max"] },
          { "required": ["warnMin"] },
          { "required": ["warnMax"] }
        ],
        "properties": {
          "metricId": { "type": "string", "minLength": 1 },
          "unit": { "type": "string", "minLength": 1 },
          "min": { "type": "number" },
          "max": { "type": "number" },
          "warnMin": { "type": "number" },
          "warnMax": { "type": "number" },
          "evidenceRefs": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "evidenceRefs": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "notes": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
