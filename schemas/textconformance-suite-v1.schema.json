{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/Ismail-elkorchi/text-computing/schemas/textconformance-suite-v1.schema.json",
  "title": "textconformance suite v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaId",
    "schemaVersion",
    "suiteId",
    "suiteVersion",
    "suiteClass",
    "subject",
    "scopeBoundary",
    "fixtures",
    "oracles",
    "checks",
    "limitations"
  ],
  "properties": {
    "schemaId": { "const": "urn:ismail-elkorchi:textconformance:suite:v1" },
    "schemaVersion": { "const": 1 },
    "suiteId": { "type": "string", "minLength": 1 },
    "suiteVersion": { "type": "string", "minLength": 1 },
    "suiteClass": { "$ref": "#/definitions/suiteClass" },
    "subject": { "$ref": "#/definitions/subject" },
    "scopeBoundary": { "type": "string", "minLength": 1 },
    "fixtures": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/fixture" }
    },
    "oracles": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/oracle" }
    },
    "targets": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/target" }
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/check" }
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "notes": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "definitions": {
    "suiteClass": {
      "enum": ["spec", "profile", "pack", "interchange", "workflow", "benchmark"]
    },
    "fixtureRole": {
      "enum": [
        "development",
        "validation",
        "holdout",
        "negative-control",
        "scope-narrowed-gap"
      ]
    },
    "oracleKind": {
      "enum": ["exact", "schema", "runtime-guard", "round-trip", "differential", "benchmark"]
    },
    "targetKind": {
      "enum": [
        "package-fixture",
        "external-consumer-project",
        "generated-package-artifact"
      ]
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id"],
      "properties": {
        "kind": { "type": "string", "minLength": 1 },
        "id": { "type": "string", "minLength": 1 },
        "schemaId": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 }
      }
    },
    "fixture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "ref"],
      "properties": {
        "role": { "$ref": "#/definitions/fixtureRole" },
        "ref": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 }
      }
    },
    "oracle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["oracleId", "kind"],
      "properties": {
        "oracleId": { "type": "string", "minLength": 1 },
        "kind": { "$ref": "#/definitions/oracleKind" },
        "ref": { "type": "string", "minLength": 1 }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["targetId", "kind", "ref"],
      "properties": {
        "targetId": { "type": "string", "minLength": 1 },
        "kind": { "$ref": "#/definitions/targetKind" },
        "ref": { "type": "string", "minLength": 1 },
        "required": { "type": "boolean" },
        "description": { "type": "string", "minLength": 1 }
      }
    },
    "traceability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requirementRefs", "apiRefs", "inputRefs", "oracleRefs", "limitations"],
      "properties": {
        "requirementRefs": { "$ref": "#/definitions/nonEmptyStringArray" },
        "apiRefs": { "$ref": "#/definitions/nonEmptyStringArray" },
        "inputRefs": { "$ref": "#/definitions/nonEmptyStringArray" },
        "oracleRefs": { "$ref": "#/definitions/nonEmptyStringArray" },
        "reportRefs": { "$ref": "#/definitions/nonEmptyStringArray" },
        "limitations": { "$ref": "#/definitions/nonEmptyStringArray" }
      }
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["checkId", "oracleId"],
      "properties": {
        "checkId": { "type": "string", "minLength": 1 },
        "oracleId": { "type": "string", "minLength": 1 },
        "expectedStatus": { "enum": ["pass", "fail", "not-run"] },
        "message": { "type": "string", "minLength": 1 },
        "evidenceRefs": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "traceability": { "$ref": "#/definitions/traceability" }
      }
    },
    "nonEmptyStringArray": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
