{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/Ismail-elkorchi/text-computing/schemas/textconformance-benchmark-matrix-report-v1.schema.json",
  "title": "Textconformance benchmark matrix report v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "artifactType",
    "matrixId",
    "generatedAt",
    "runCount",
    "benchmarkCount",
    "subjectCount",
    "hostCount",
    "metricCount",
    "summary",
    "rows",
    "evidenceRefs",
    "limitations"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "artifactType": { "const": "textconformance-benchmark-matrix-report-v1" },
    "matrixId": { "type": "string", "minLength": 1 },
    "generatedAt": { "type": "string", "minLength": 1 },
    "runCount": { "type": "integer", "minimum": 1 },
    "benchmarkCount": { "type": "integer", "minimum": 0 },
    "subjectCount": { "type": "integer", "minimum": 0 },
    "hostCount": { "type": "integer", "minimum": 0 },
    "metricCount": { "type": "integer", "minimum": 0 },
    "summary": { "$ref": "#/definitions/summary" },
    "rows": {
      "type": "array",
      "items": { "$ref": "#/definitions/row" }
    },
    "evidenceRefs": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "notes": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "definitions": {
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id"],
      "properties": {
        "kind": { "type": "string", "minLength": 1 },
        "id": { "type": "string", "minLength": 1 },
        "schemaId": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["complete", "incomplete"],
      "properties": {
        "complete": { "type": "integer", "minimum": 0 },
        "incomplete": { "type": "integer", "minimum": 0 }
      }
    },
    "value": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runId", "value", "generatedAt", "evidenceRefs"],
      "properties": {
        "runId": { "type": "string", "minLength": 1 },
        "value": { "type": "number" },
        "generatedAt": { "type": "string", "minLength": 1 },
        "evidenceRefs": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "hostId": { "type": "string", "minLength": 1 }
      }
    },
    "row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "benchmarkId",
        "subjectKey",
        "subject",
        "metricId",
        "unit",
        "status",
        "runCount",
        "observedRunCount",
        "missingRunIds",
        "min",
        "max",
        "mean",
        "median",
        "values"
      ],
      "properties": {
        "benchmarkId": { "type": "string", "minLength": 1 },
        "subjectKey": { "type": "string", "minLength": 1 },
        "subject": { "$ref": "#/definitions/subject" },
        "metricId": { "type": "string", "minLength": 1 },
        "unit": { "type": "string", "minLength": 1 },
        "higherIsPreferred": { "type": "boolean" },
        "status": { "enum": ["complete", "incomplete"] },
        "runCount": { "type": "integer", "minimum": 1 },
        "observedRunCount": { "type": "integer", "minimum": 1 },
        "missingRunIds": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "min": { "type": "number" },
        "max": { "type": "number" },
        "mean": { "type": "number" },
        "median": { "type": "number" },
        "values": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/value" }
        }
      }
    }
  }
}
