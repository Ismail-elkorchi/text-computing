{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/Ismail-elkorchi/text-computing/schemas/dependency-parser-expected-v1.schema.json",
  "title": "Dependency parser expected arcs v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "taskId",
    "fixtureId",
    "sourceConlluPath",
    "documentId",
    "sentenceId",
    "tokenOrder",
    "arcs",
    "rootCount",
    "supportBoundary"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "taskId": { "const": "nlp-dependency-parser" },
    "fixtureId": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "sourceConlluPath": {
      "type": "string",
      "pattern": "^fixtures/conllu-dependency/valid/[a-z0-9-]+\\.conllu$"
    },
    "documentId": { "type": "string", "minLength": 1 },
    "sentenceId": { "type": "string", "minLength": 1 },
    "tokenOrder": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "pattern": "^[1-9][0-9]*$" }
    },
    "arcs": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/arc" }
    },
    "rootCount": { "type": "integer", "minimum": 1 },
    "supportBoundary": { "type": "string", "minLength": 1 },
    "notes": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "definitions": {
    "arc": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dependent", "head", "relation"],
      "properties": {
        "dependent": { "type": "string", "pattern": "^[1-9][0-9]*$" },
        "head": { "type": "string", "pattern": "^[0-9]+$" },
        "relation": { "type": "string", "pattern": "^[a-z]+(:[a-z]+)?$" }
      }
    }
  }
}
