{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/Ismail-elkorchi/text-computing/schemas/rule-backed-ner-slices-v1.schema.json",
  "title": "Rule-backed NER readiness slices v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "expectedOutputStatus",
    "allowedFixturePolicy",
    "labelPolicyControls",
    "corpusEvidence",
    "slices"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "expectedOutputStatus": {
      "enum": [
        "schema-defined",
        "recorded"
      ]
    },
    "allowedFixturePolicy": {
      "type": "string",
      "minLength": 1
    },
    "labelPolicyControls": {
      "type": "object",
      "additionalProperties": false,
      "required": ["emittedLabels", "rejectedLabels", "unsupportedLabelPolicy"],
      "properties": {
        "emittedLabels": {
          "type": "array",
          "minItems": 1,
          "items": { "enum": ["PER", "ORG", "LOC"] },
          "uniqueItems": true
        },
        "rejectedLabels": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["label", "reason"],
            "properties": {
              "label": { "type": "string", "minLength": 1 },
              "reason": { "type": "string", "minLength": 1 }
            }
          }
        },
        "unsupportedLabelPolicy": { "type": "string", "minLength": 1 }
      }
    },
    "corpusEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["corpusId", "license", "splitPolicy", "resourceRefs", "documents", "limitations"],
      "properties": {
        "corpusId": { "type": "string", "minLength": 1 },
        "license": { "type": "string", "minLength": 1 },
        "splitPolicy": { "type": "string", "minLength": 1 },
        "resourceRefs": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "documents": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/corpusDocument" }
        },
        "limitations": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "slices": {
      "type": "array",
      "minItems": 5,
      "items": {
        "$ref": "#/definitions/slice"
      }
    }
  },
  "definitions": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "text"
      ],
      "properties": {
        "kind": {
          "const": "text"
        },
        "text": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "slice": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "languageHint",
        "phenomena",
        "fixtureClass",
        "source"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "languageHint": {
          "type": "string",
          "minLength": 1
        },
        "phenomena": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": [
              "nested-span",
              "overlapping-span",
              "alias",
              "capitalization-ambiguity",
              "false-match",
              "latin-script-non-english",
              "non-latin-script"
            ]
          }
        },
        "fixtureClass": {
          "enum": [
            "repository-authored",
            "public-domain",
            "cc0-compatible"
          ]
        },
        "source": {
          "$ref": "#/definitions/source"
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "corpusDocument": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sliceId",
        "expectedPath",
        "sourceSha256",
        "splitRole",
        "language",
        "phenomena",
        "entityCount"
      ],
      "properties": {
        "sliceId": { "type": "string", "minLength": 1 },
        "expectedPath": {
          "type": "string",
          "pattern": "^fixtures/rule-backed-ner/expected/[^/]+\\.json$"
        },
        "sourceSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "splitRole": { "enum": ["development", "validation", "holdout", "negative-control"] },
        "language": { "type": "string", "minLength": 1 },
        "phenomena": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "entityCount": { "type": "integer", "minimum": 0 },
        "falsePositiveControls": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        }
      }
    }
  }
}
