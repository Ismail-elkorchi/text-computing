{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/Ismail-elkorchi/text-computing/schemas/evidence-replay-v1.schema.json",
  "title": "Evidence replay manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "generatedAt", "tasks"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "generatedAt": { "type": "string", "minLength": 1 },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/taskReplay" }
    }
  },
  "definitions": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "validatorRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["argv", "path", "sha256"],
      "properties": {
        "argv": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/definitions/sha256" }
      }
    },
    "comparator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "runtime"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "runtime": { "type": "string", "minLength": 1 },
        "model": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "version"],
          "properties": {
            "name": { "type": "string", "minLength": 1 },
            "version": { "type": "string", "minLength": 1 }
          }
        },
        "license": { "type": "string", "minLength": 1 }
      }
    },
    "comparisonRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "comparator", "status"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/definitions/sha256" },
        "comparator": { "$ref": "#/definitions/comparator" },
        "status": { "enum": ["pass", "fail", "not-run"] }
      }
    },
    "taskReplay": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "task",
        "taskId",
        "status",
        "validators",
        "comparisons",
        "conformanceReportRefs"
      ],
      "properties": {
        "task": { "type": "string", "minLength": 1 },
        "taskId": { "type": "string", "minLength": 1 },
        "status": { "enum": ["ok", "gap-recorded"] },
        "validators": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/validatorRef" }
        },
        "comparisons": {
          "type": "array",
          "items": { "$ref": "#/definitions/comparisonRef" }
        },
        "conformanceReportRefs": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "knownGap": { "type": "string", "minLength": 1 }
      }
    }
  }
}
