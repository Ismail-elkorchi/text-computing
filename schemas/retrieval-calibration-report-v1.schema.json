{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/Ismail-elkorchi/text-computing/schemas/retrieval-calibration-report-v1.schema.json",
  "title": "Retrieval calibration report v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "taskId",
    "reportId",
    "corpusId",
    "evidenceClass",
    "selection",
    "formula",
    "k",
    "relevantGradeThreshold",
    "tolerance",
    "optimizeMetric",
    "baselineCandidateId",
    "selectedCandidateId",
    "candidateOrder",
    "candidates"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "taskId": { "const": "nlp-retrieval" },
    "reportId": { "type": "string", "minLength": 1 },
    "corpusId": { "type": "string", "minLength": 1 },
    "evidenceClass": { "const": "E2" },
    "selection": { "type": "object" },
    "formula": {
      "enum": [
        "bm25.okapi.k1-1.5.b-0.75",
        "bm25f.k1-1.2.b-0.75.fielded"
      ]
    },
    "k": { "type": "integer", "minimum": 1 },
    "relevantGradeThreshold": { "type": "integer", "minimum": 1 },
    "tolerance": { "type": "number", "minimum": 0 },
    "optimizeMetric": {
      "enum": ["precisionAtK", "recallAtK", "mrr", "ndcgAtK"]
    },
    "baselineCandidateId": { "type": "string", "minLength": 1 },
    "selectedCandidateId": { "type": "string", "minLength": 1 },
    "candidateOrder": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "candidates": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/candidate" }
    }
  },
  "definitions": {
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["precisionAtK", "recallAtK", "mrr", "ndcgAtK"],
      "properties": {
        "precisionAtK": { "type": "number" },
        "recallAtK": { "type": "number" },
        "mrr": { "type": "number" },
        "ndcgAtK": { "type": "number" }
      }
    },
    "fieldWeight": {
      "type": "object",
      "additionalProperties": false,
      "required": ["field", "weight"],
      "properties": {
        "field": { "type": "string", "minLength": 1 },
        "weight": { "type": "number", "minimum": 0 }
      }
    },
    "fieldWeightProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "profileId", "formula", "fields"],
      "properties": {
        "schemaVersion": { "const": 1 },
        "profileId": { "type": "string", "minLength": 1 },
        "formula": { "const": "bm25f.k1-1.2.b-0.75.fielded" },
        "fields": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/fieldWeight" }
        }
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidateId",
        "rank",
        "selected",
        "formula",
        "summary",
        "deltasFromBaseline",
        "metricScore",
        "withinToleranceOfSelected"
      ],
      "properties": {
        "candidateId": { "type": "string", "minLength": 1 },
        "rank": { "type": "integer", "minimum": 1 },
        "selected": { "type": "boolean" },
        "formula": {
          "enum": [
            "bm25.okapi.k1-1.5.b-0.75",
            "bm25f.k1-1.2.b-0.75.fielded"
          ]
        },
        "fieldWeightProfile": { "$ref": "#/definitions/fieldWeightProfile" },
        "summary": { "$ref": "#/definitions/summary" },
        "deltasFromBaseline": { "$ref": "#/definitions/summary" },
        "metricScore": { "type": "number" },
        "withinToleranceOfSelected": { "type": "boolean" }
      }
    }
  }
}
