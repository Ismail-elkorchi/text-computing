{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/Ismail-elkorchi/text-computing/schemas/dependency-parser-tool-versions-v1.schema.json",
  "title": "Dependency parser standards manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "scope",
    "standards"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "scope": { "const": "dependency-parser" },
    "standards": {
      "type": "array",
      "minItems": 2,
      "items": { "$ref": "#/definitions/source" }
    }
  },
  "definitions": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "url", "version", "role"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "pattern": "^https://" },
        "version": { "type": "string", "minLength": 1 },
        "role": { "type": "string", "minLength": 1 }
      }
    }
  }
}
