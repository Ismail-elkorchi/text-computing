{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/Ismail-elkorchi/text-computing/schemas/dependency-parser-comparison-v1.schema.json",
  "title": "Dependency parser comparator capture v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "scope",
    "capturedDate",
    "comparator",
    "executionStatus",
    "captureMode",
    "slices",
    "notes"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "scope": { "const": "dependency-parser" },
    "capturedDate": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "comparator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "runtime", "artifactSurface"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "runtime": { "enum": ["python", "jvm", "javascript", "other"] },
        "artifactSurface": { "type": "string", "minLength": 1 }
      }
    },
    "executionStatus": {
      "enum": [
        "capability-recorded",
        "executed"
      ]
    },
    "captureMode": {
      "enum": [
        "curated-local-execution",
        "capability-record"
      ]
    },
    "dependencies": {
      "type": "array",
      "items": { "$ref": "#/definitions/dependency" }
    },
    "slices": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/sliceComparison" }
    },
    "notes": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "definitions": {
    "dependency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "role"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "role": { "type": "string", "minLength": 1 }
      }
    },
    "arc": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dependent", "head", "relation"],
      "properties": {
        "dependent": { "type": "string", "pattern": "^[1-9][0-9]*$" },
        "head": { "type": "string", "pattern": "^[0-9]+$" },
        "relation": { "type": "string", "pattern": "^[A-Za-z]+(:[A-Za-z]+)?$" },
        "text": { "type": "string" },
        "headText": { "type": "string" }
      }
    },
    "difference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": {
          "enum": [
            "arc-mismatch",
            "missing-dependent",
            "tokenization-mismatch"
          ]
        },
        "dependent": { "type": "string", "pattern": "^[1-9][0-9]*$" },
        "expectedHead": { "type": "string", "pattern": "^[0-9]+$" },
        "expectedRelation": { "type": "string", "pattern": "^[a-z]+(:[a-z]+)?$" },
        "actualHead": { "type": "string", "pattern": "^[0-9]+$" },
        "actualRelation": { "type": "string", "pattern": "^[A-Za-z]+(:[A-Za-z]+)?$" },
        "actualText": { "type": "string" },
        "expectedTokenCount": { "type": "integer", "minimum": 0 },
        "actualTokenCount": { "type": "integer", "minimum": 0 },
        "message": { "type": "string", "minLength": 1 }
      }
    },
    "sliceComparison": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fixtureId", "status", "expectedArcPath"],
      "properties": {
        "fixtureId": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "status": {
          "enum": [
            "output-not-captured",
            "captured"
          ]
        },
        "expectedArcPath": {
          "type": "string",
          "pattern": "^fixtures/dependency-parser/expected/[a-z0-9-]+\\.json$"
        },
        "reason": { "type": "string", "minLength": 1 },
        "matchesExpected": { "type": "boolean" },
        "outputArcs": {
          "type": "array",
          "items": { "$ref": "#/definitions/arc" }
        },
        "differences": {
          "type": "array",
          "items": { "$ref": "#/definitions/difference" }
        }
      }
    }
  }
}
