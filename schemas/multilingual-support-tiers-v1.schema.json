{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/Ismail-elkorchi/text-computing/schemas/multilingual-support-tiers-v1.schema.json",
  "title": "multilingual support tiers v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "scope", "externalReference", "tiers", "scriptFixtures"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "scope": { "const": "multilingual-support" },
    "externalReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "releaseDate", "treebanks", "languages", "sourceRefs"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "releaseDate": { "type": "string", "minLength": 1 },
        "treebanks": { "type": "integer", "minimum": 1 },
        "languages": { "type": "integer", "minimum": 1 },
        "sourceRefs": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "tiers": {
      "type": "array",
      "minItems": 5,
      "items": { "$ref": "#/definitions/tier" }
    },
    "scriptFixtures": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/scriptFixture" }
    },
    "notes": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "definitions": {
    "tierName": {
      "enum": [
        "unicode-invariant",
        "fixture-proven",
        "resource-backed",
        "comparator-backed",
        "corpus-backed"
      ]
    },
    "tier": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "status", "definition", "claimBoundary", "evidenceRefs", "limitations"],
      "properties": {
        "name": { "$ref": "#/definitions/tierName" },
        "status": { "enum": ["present", "partial", "gap"] },
        "definition": { "type": "string", "minLength": 1 },
        "claimBoundary": { "type": "string", "minLength": 1 },
        "evidenceRefs": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "limitations": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "scriptFixture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "language",
        "script",
        "direction",
        "supportTier",
        "inputPath",
        "sha256",
        "evidenceRefs",
        "limitations"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "language": { "type": "string", "minLength": 2 },
        "script": { "type": "string", "minLength": 1 },
        "direction": { "enum": ["ltr", "rtl", "mixed"] },
        "supportTier": { "enum": ["fixture-proven", "readiness-only"] },
        "inputPath": {
          "type": "string",
          "pattern": "^fixtures/multilingual-support/inputs/[a-z0-9-]+\\.txt$"
        },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "evidenceRefs": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "limitations": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
