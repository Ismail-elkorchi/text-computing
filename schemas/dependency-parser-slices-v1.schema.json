{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/Ismail-elkorchi/text-computing/schemas/dependency-parser-slices-v1.schema.json",
  "title": "Dependency parser readiness slices v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "scope",
    "expectedOutputStatus",
    "comparatorStatus",
    "fixtures",
    "negativeControls"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "scope": {
      "const": "dependency-parser"
    },
    "expectedOutputStatus": {
      "const": "recorded"
    },
    "comparatorStatus": {
      "enum": [
        "capability-recorded",
        "executed-captures-recorded"
      ]
    },
    "fixtures": {
      "type": "array",
      "minItems": 2,
      "items": {
        "$ref": "#/definitions/fixture"
      }
    },
    "negativeControls": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/definitions/negativeControl"
      }
    }
  },
  "definitions": {
    "fixture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "language",
        "sourceConlluPath",
        "expectedPath",
        "phenomena"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$"
        },
        "language": {
          "type": "string",
          "minLength": 2
        },
        "sourceConlluPath": {
          "type": "string",
          "pattern": "^fixtures/conllu-dependency/valid/[a-z0-9-]+\\.conllu$"
        },
        "expectedPath": {
          "type": "string",
          "pattern": "^fixtures/dependency-parser/expected/[a-z0-9-]+\\.json$"
        },
        "phenomena": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "root-arc",
              "subject-arc",
              "object-arc",
              "oblique-arc",
              "punctuation-arc",
              "multiword-token",
              "morphologically-rich-form",
              "non-english-latin-script",
              "non-latin-script",
              "right-to-left-script"
            ]
          }
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "negativeControl": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "sourceConlluPath",
        "expectedFailure"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$"
        },
        "sourceConlluPath": {
          "type": "string",
          "pattern": "^fixtures/conllu-dependency/invalid/[a-z0-9-]+\\.conllu$"
        },
        "expectedFailure": {
          "enum": [
            "invalid-head",
            "dangling-head",
            "missing-root",
            "multiple-roots",
            "malformed-field-count",
            "missing-deprel"
          ]
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
