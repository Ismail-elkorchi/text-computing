{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/Ismail-elkorchi/text-computing/schemas/textprotocol-protocol-error-v1.schema.json",
  "title": "textprotocol protocol error v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaId", "schemaVersion", "producer", "payload"],
  "properties": {
    "schemaId": { "const": "urn:ismail-elkorchi:textprotocol:protocol-error:v1" },
    "schemaVersion": { "const": 1 },
    "producer": { "$ref": "#/definitions/producer" },
    "payload": { "$ref": "#/definitions/errorPayload" },
    "provenance": { "$ref": "#/definitions/provenance" },
    "diagnostics": { "$ref": "#/definitions/diagnostics" },
    "limitations": { "$ref": "#/definitions/nonEmptyStringArray" },
    "extensions": { "type": "object" }
  },
  "definitions": {
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["package", "version"],
      "properties": {
        "package": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 }
      }
    },
    "errorPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "severity", "message"],
      "properties": {
        "code": { "type": "string", "minLength": 1 },
        "severity": { "enum": ["info", "warning", "error"] },
        "message": { "type": "string", "minLength": 1 },
        "schemaId": { "type": "string", "minLength": 1 },
        "path": { "type": "string", "minLength": 1 },
        "remediation": { "type": "string", "minLength": 1 },
        "causes": { "type": "array", "items": { "$ref": "#/definitions/errorPayload" } }
      }
    },
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id"],
      "properties": {
        "kind": { "type": "string", "minLength": 1 },
        "id": { "type": "string", "minLength": 1 }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id"],
          "properties": {
            "id": { "type": "string", "minLength": 1 },
            "sha256": { "type": "string", "minLength": 1 }
          }
        },
        "references": { "type": "array", "items": { "$ref": "#/definitions/reference" } }
      }
    },
    "diagnostics": { "type": "array", "items": { "$ref": "#/definitions/diagnostic" } },
    "diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "severity"],
      "properties": {
        "code": { "type": "string", "minLength": 1 },
        "severity": { "enum": ["info", "warning", "error"] },
        "message": { "type": "string", "minLength": 1 }
      }
    },
    "nonEmptyStringArray": { "type": "array", "items": { "type": "string", "minLength": 1 } }
  }
}
