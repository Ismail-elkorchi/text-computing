{
	"$schema": "http://json-schema.org/draft-07/schema#",
	"$id": "https://github.com/Ismail-elkorchi/text-computing/schemas/text-computing-ner-evaluation.schema.json",
	"title": "TextComputingNerEvaluation",
	"type": "object",
	"additionalProperties": false,
	"required": [
		"schemaVersion",
		"task",
		"modelId",
		"artifactId",
		"artifactChecksum",
		"executorId",
		"spanMatching",
		"targetLabels",
		"sampling",
		"languages",
		"aggregate",
		"limitations"
	],
	"properties": {
		"schemaVersion": { "const": "1" },
		"task": { "const": "entities" },
		"modelId": { "type": "string", "minLength": 1 },
		"artifactId": { "type": "string", "minLength": 1 },
		"artifactChecksum": { "$ref": "#/definitions/sha256" },
		"executorId": { "type": "string", "minLength": 1 },
		"spanMatching": { "const": "exact-utf16-span-and-type" },
		"targetLabels": {
			"type": "array",
			"minItems": 1,
			"uniqueItems": true,
			"items": { "type": "string", "minLength": 1 }
		},
		"sampling": {
			"type": "object",
			"additionalProperties": false,
			"required": ["method", "key", "sampleSizePerLanguage"],
			"properties": {
				"method": { "const": "lowest-sha256" },
				"key": { "type": "string", "minLength": 1 },
				"sampleSizePerLanguage": {
					"type": "integer",
					"minimum": 1
				}
			}
		},
		"languages": {
			"type": "array",
			"minItems": 1,
			"items": { "$ref": "#/definitions/languageResult" }
		},
		"aggregate": { "$ref": "#/definitions/result" },
		"limitations": {
			"type": "array",
			"minItems": 1,
			"items": { "type": "string", "minLength": 1 }
		}
	},
	"definitions": {
		"sha256": {
			"type": "string",
			"pattern": "^sha256:[0-9a-f]{64}$"
		},
		"counts": {
			"type": "object",
			"additionalProperties": false,
			"required": ["truePositive", "falsePositive", "falseNegative"],
			"properties": {
				"truePositive": { "type": "integer", "minimum": 0 },
				"falsePositive": { "type": "integer", "minimum": 0 },
				"falseNegative": { "type": "integer", "minimum": 0 }
			}
		},
		"metrics": {
			"type": "object",
			"additionalProperties": false,
			"required": ["precision", "recall", "f1"],
			"properties": {
				"precision": { "type": "number", "minimum": 0, "maximum": 1 },
				"recall": { "type": "number", "minimum": 0, "maximum": 1 },
				"f1": { "type": "number", "minimum": 0, "maximum": 1 }
			}
		},
		"result": {
			"type": "object",
			"additionalProperties": false,
			"required": ["sampleSize", "counts", "metrics"],
			"properties": {
				"sampleSize": { "type": "integer", "minimum": 1 },
				"counts": { "$ref": "#/definitions/counts" },
				"metrics": { "$ref": "#/definitions/metrics" }
			}
		},
		"languageResult": {
			"type": "object",
			"additionalProperties": false,
			"required": [
				"languageTag",
				"dataset",
				"sourceId",
				"snapshotId",
				"checksum",
				"sampleSize",
				"counts",
				"metrics"
			],
			"properties": {
				"languageTag": { "type": "string", "minLength": 1 },
				"dataset": { "type": "string", "minLength": 1 },
				"sourceId": { "type": "string", "minLength": 1 },
				"snapshotId": { "type": "string", "minLength": 1 },
				"checksum": { "$ref": "#/definitions/sha256" },
				"sampleSize": { "type": "integer", "minimum": 1 },
				"counts": { "$ref": "#/definitions/counts" },
				"metrics": { "$ref": "#/definitions/metrics" }
			}
		}
	}
}
