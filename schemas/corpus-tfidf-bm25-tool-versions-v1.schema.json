{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "corpus-tfidf-bm25-tool-versions-v1.schema.json",
  "title": "Corpus TF-IDF/BM25 formula manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "taskId",
    "formulas"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "taskId": {
      "const": "nlp-corpus-tfidf-bm25"
    },
    "formulas": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "description"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "parameters": {
            "type": "object",
            "additionalProperties": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "number"
                },
                {
                  "type": "boolean"
                }
              ]
            }
          }
        }
      }
    }
  }
}
