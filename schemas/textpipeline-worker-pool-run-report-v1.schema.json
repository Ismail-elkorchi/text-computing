{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/Ismail-elkorchi/text-computing/schemas/textpipeline-worker-pool-run-report-v1.schema.json",
  "title": "textpipeline worker pool run report v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "poolId",
    "strategy",
    "workerIds",
    "documentCount",
    "completeCount",
    "partialCount",
    "executionModes",
    "cachePolicies",
    "contextFingerprints",
    "items"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "poolId": { "type": "string", "minLength": 1 },
    "strategy": { "const": "round-robin" },
    "workerIds": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "documentCount": { "type": "integer", "minimum": 0 },
    "completeCount": { "type": "integer", "minimum": 0 },
    "partialCount": { "type": "integer", "minimum": 0 },
    "executionModes": {
      "type": "array",
      "items": { "enum": ["sync", "async"] },
      "uniqueItems": true
    },
    "cachePolicies": {
      "type": "array",
      "items": { "enum": ["none", "read-through"] },
      "uniqueItems": true
    },
    "contextFingerprints": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "inputIndex",
          "documentId",
          "finalRevision",
          "runStatus",
          "executionMode",
          "cachePolicy",
          "processorOrder",
          "traceEntryCount",
          "workerId",
          "workerSlot"
        ],
        "properties": {
          "inputIndex": { "type": "integer", "minimum": 0 },
          "documentId": { "type": "string", "minLength": 1 },
          "finalRevision": { "type": "string", "minLength": 1 },
          "runStatus": { "enum": ["complete", "partial"] },
          "executionMode": { "enum": ["sync", "async"] },
          "cachePolicy": { "enum": ["none", "read-through"] },
          "processorOrder": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "traceEntryCount": { "type": "integer", "minimum": 0 },
          "workerId": { "type": "string", "minLength": 1 },
          "workerSlot": { "type": "integer", "minimum": 0 }
        }
      }
    }
  }
}
