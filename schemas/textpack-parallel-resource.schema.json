{
	"$schema": "http://json-schema.org/draft-07/schema#",
	"$id": "https://github.com/Ismail-elkorchi/text-computing/schemas/textpack-parallel-resource.schema.json",
	"title": "TextpackParallelResource",
	"type": "object",
	"additionalProperties": false,
	"required": ["schemaVersion", "kind", "parallelId", "languagePair"],
	"properties": {
		"schemaVersion": { "const": "1" },
		"kind": { "enum": ["translation-memory", "alignment-table"] },
		"parallelId": { "type": "string", "minLength": 1 },
		"languagePair": { "$ref": "#/definitions/languagePair" },
		"units": {
			"type": "array",
			"items": { "$ref": "#/definitions/unit" }
		},
		"alignments": {
			"type": "array",
			"items": { "$ref": "#/definitions/alignment" }
		},
		"bilingualLexicon": {
			"type": "array",
			"items": { "$ref": "#/definitions/bilingualEntry" }
		}
	},
	"definitions": {
		"languagePair": {
			"type": "object",
			"additionalProperties": false,
			"required": ["sourceLanguage", "targetLanguage"],
			"properties": {
				"sourceLanguage": { "type": "string", "minLength": 1 },
				"targetLanguage": { "type": "string", "minLength": 1 },
				"sourceScript": { "type": "string", "minLength": 1 },
				"targetScript": { "type": "string", "minLength": 1 }
			}
		},
		"unit": {
			"type": "object",
			"additionalProperties": false,
			"required": ["unitId"],
			"properties": {
				"unitId": { "type": "string", "minLength": 1 },
				"sourceText": { "type": "string" },
				"targetText": { "type": "string" },
				"sourceDocumentId": { "type": "string", "minLength": 1 },
				"targetDocumentId": { "type": "string", "minLength": 1 },
				"sourceSpan": { "$ref": "#/definitions/span" },
				"targetSpan": { "$ref": "#/definitions/span" },
				"score": { "type": "number", "minimum": 0, "maximum": 1 },
				"metadata": { "$ref": "#/definitions/jsonObject" }
			}
		},
		"alignment": {
			"type": "object",
			"additionalProperties": false,
			"required": ["alignmentId", "sourceIds", "targetIds", "relation"],
			"properties": {
				"alignmentId": { "type": "string", "minLength": 1 },
				"sourceIds": {
					"type": "array",
					"minItems": 1,
					"items": { "type": "string", "minLength": 1 }
				},
				"targetIds": {
					"type": "array",
					"minItems": 1,
					"items": { "type": "string", "minLength": 1 }
				},
				"relation": {
					"enum": [
						"equivalent",
						"contains",
						"contained-by",
						"partial",
						"unaligned"
					]
				},
				"score": { "type": "number", "minimum": 0, "maximum": 1 }
			}
		},
		"bilingualEntry": {
			"type": "object",
			"additionalProperties": false,
			"required": ["entryId", "sourceForm", "targetForm"],
			"properties": {
				"entryId": { "type": "string", "minLength": 1 },
				"sourceForm": { "type": "string", "minLength": 1 },
				"targetForm": { "type": "string", "minLength": 1 },
				"partOfSpeech": { "type": "string", "minLength": 1 },
				"score": { "type": "number", "minimum": 0, "maximum": 1 }
			}
		},
		"span": {
			"type": "object",
			"additionalProperties": false,
			"required": ["start", "end"],
			"properties": {
				"start": { "type": "integer", "minimum": 0 },
				"end": { "type": "integer", "minimum": 0 }
			}
		},
		"jsonValue": {
			"anyOf": [
				{ "type": "null" },
				{ "type": "boolean" },
				{ "type": "number" },
				{ "type": "string" },
				{
					"type": "array",
					"items": { "$ref": "#/definitions/jsonValue" }
				},
				{ "$ref": "#/definitions/jsonObject" }
			]
		},
		"jsonObject": {
			"type": "object",
			"additionalProperties": { "$ref": "#/definitions/jsonValue" }
		}
	}
}
