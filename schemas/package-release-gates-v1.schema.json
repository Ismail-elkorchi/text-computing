{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/Ismail-elkorchi/text-computing/schemas/package-release-gates-v1.schema.json",
  "title": "Package release gates v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "scope", "requiredGates", "dependencyReleaseOrder", "packages"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "scope": { "const": "package-release-gates" },
    "requiredGates": {
      "type": "array",
      "minItems": 7,
      "uniqueItems": true,
      "items": {
        "enum": [
          "metadata",
          "tests",
          "schemas",
          "package-quality",
          "security-review",
          "claim-hygiene",
          "downstream-api-stability"
        ]
      }
    },
    "dependencyReleaseOrder": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/dependencyReleaseStage" }
    },
    "packages": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/packageGate" }
    },
    "notes": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "definitions": {
    "repoRef": {
      "type": "string",
      "minLength": 1,
      "not": {
        "anyOf": [
          { "pattern": "^/" },
          { "pattern": "\\.\\." },
          { "pattern": "\\\\" },
          { "pattern": "^https?://" }
        ]
      }
    },
    "dependencyReleaseStage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stage", "packages", "policy", "requiredEvidenceRefs"],
      "properties": {
        "stage": {
          "type": "integer",
          "minimum": 0
        },
        "packages": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^@ismail-elkorchi/[a-z]+$" }
        },
        "policy": { "type": "string", "minLength": 1 },
        "requiredEvidenceRefs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/definitions/repoRef" }
        }
      }
    },
    "packageGate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "packageName",
        "releaseTrack",
        "supportStatus",
        "releaseReadiness",
        "gates",
        "downstreamApiStability",
        "releaseBlockers",
        "evidenceRefs",
        "limitations"
      ],
      "properties": {
        "packageName": { "type": "string", "pattern": "^@ismail-elkorchi/[a-z]+$" },
        "releaseTrack": {
          "enum": ["public-beta", "private-unreleased"]
        },
        "supportStatus": {
          "enum": ["scaffold", "readiness-only", "slice-proven", "beta", "production-candidate"]
        },
        "releaseReadiness": {
          "enum": ["publishable", "blocked"]
        },
        "gates": {
          "type": "array",
          "minItems": 7,
          "uniqueItems": true,
          "items": {
            "enum": [
              "metadata",
              "tests",
              "schemas",
              "package-quality",
              "security-review",
              "claim-hygiene",
              "downstream-api-stability"
            ]
          }
        },
        "downstreamApiStability": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "requiredBeforeRelease",
            "status",
            "downstreamDependents",
            "evidenceRefs",
            "policy"
          ],
          "properties": {
            "requiredBeforeRelease": { "type": "boolean" },
            "status": { "enum": ["not-required", "blocked", "proven"] },
            "downstreamDependents": {
              "type": "array",
              "uniqueItems": true,
              "items": { "type": "string", "pattern": "^@ismail-elkorchi/[a-z]+$" }
            },
            "evidenceRefs": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 }
            },
            "policy": { "type": "string", "minLength": 1 }
          }
        },
        "releaseBlockers": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "evidenceRefs": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "limitations": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
