{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/Ismail-elkorchi/text-computing/schemas/pos-morph-lemma-tool-versions-v1.schema.json",
  "title": "POS, morphology, and lemma target contract v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "targetTagSet",
    "targetMorphFeatures",
    "retainAmbiguity"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "targetTagSet": { "const": "ud-v2-upos" },
    "targetMorphFeatures": { "const": "ud-v2-features" },
    "retainAmbiguity": { "const": true },
    "notes": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
