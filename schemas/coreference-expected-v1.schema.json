{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/Ismail-elkorchi/text-computing/schemas/coreference-expected-v1.schema.json",
  "title": "Coreference expected output v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "taskId", "sliceId", "mentions", "chains"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "taskId": { "const": "nlp-coreference" },
    "sliceId": { "type": "string", "minLength": 1 },
    "mentions": {
      "type": "array",
      "items": { "$ref": "#/definitions/mention" }
    },
    "chains": {
      "type": "array",
      "items": { "$ref": "#/definitions/chain" }
    }
  },
  "definitions": {
    "mention": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "target"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["proper", "nominal", "pronoun", "singleton"] },
        "target": { "$ref": "#/definitions/span" }
      }
    },
    "chain": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "mentionIds"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "mentionIds": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "diagnostics": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "span": {
      "type": "object",
      "additionalProperties": false,
      "required": ["startCU", "endCU"],
      "properties": {
        "startCU": { "type": "integer", "minimum": 0 },
        "endCU": { "type": "integer", "minimum": 0 },
        "text": { "type": "string" }
      }
    }
  }
}
