{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/Ismail-elkorchi/text-computing/schemas/evidence-ledger-v1.schema.json",
  "title": "Evidence ledger v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaId", "schemaVersion", "ledgerId", "generatedAt", "repo", "tasks"],
  "properties": {
    "schemaId": { "const": "urn:ismail-elkorchi:evidence:ledger:v1" },
    "schemaVersion": { "const": 1 },
    "ledgerId": { "type": "string", "minLength": 1 },
    "generatedAt": { "type": "string", "minLength": 1 },
    "repo": { "$ref": "#/definitions/repoState" },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/taskEvidence" }
    },
    "notes": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "definitions": {
    "repoState": {
      "type": "object",
      "additionalProperties": false,
      "required": ["headSha", "dirty"],
      "properties": {
        "headSha": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "dirty": { "type": "boolean" },
        "branch": { "type": "string", "minLength": 1 },
        "remote": { "type": "string", "minLength": 1 }
      }
    },
    "taskEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["taskId", "status", "runRefs", "conformanceReportRefs", "knownGaps"],
      "properties": {
        "taskId": { "type": "string", "minLength": 1 },
        "status": { "enum": ["current", "incomplete", "drifted"] },
        "runRefs": {
          "type": "array",
          "items": { "$ref": "#/definitions/runRef" }
        },
        "conformanceReportRefs": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "knownGaps": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "runRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runId", "path", "taskId", "status", "repoHeadSha", "comparator"],
      "properties": {
        "runId": { "type": "string", "minLength": 1 },
        "path": { "type": "string", "minLength": 1 },
        "taskId": { "type": "string", "minLength": 1 },
        "status": { "enum": ["pass", "fail", "not-run"] },
        "repoHeadSha": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "comparator": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "version"],
          "properties": {
            "name": { "type": "string", "minLength": 1 },
            "version": { "type": "string", "minLength": 1 }
          }
        }
      }
    }
  }
}
