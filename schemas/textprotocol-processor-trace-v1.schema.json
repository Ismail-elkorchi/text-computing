{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/Ismail-elkorchi/text-computing/schemas/textprotocol-processor-trace-v1.schema.json",
  "title": "textprotocol processor trace v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaId", "schemaVersion", "producer", "payload"],
  "properties": {
    "schemaId": { "const": "urn:ismail-elkorchi:textprotocol:processor-trace:v1" },
    "schemaVersion": { "const": 1 },
    "producer": { "$ref": "#/definitions/producer" },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["documentId", "finalRevision", "entries"],
      "properties": {
        "documentId": { "type": "string", "minLength": 1 },
        "schemaVersion": { "const": 1 },
        "finalRevision": { "type": "string", "minLength": 1 },
        "entries": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["processorId", "version", "status", "inputRevision", "outputRevision", "emittedViews", "emittedLayers"],
            "properties": {
              "processorId": { "type": "string", "minLength": 1 },
              "version": { "type": "string", "minLength": 1 },
              "status": { "enum": ["applied", "skipped", "failed"] },
              "inputRevision": { "type": "string", "minLength": 1 },
              "outputRevision": { "type": "string", "minLength": 1 },
              "emittedViews": { "type": "array", "items": { "type": "string", "minLength": 1 } },
              "emittedLayers": { "type": "array", "items": { "type": "string", "minLength": 1 } },
              "diagnostics": { "$ref": "#/definitions/diagnostics" },
              "resources": { "type": "array", "items": { "$ref": "#/definitions/reference" } },
              "parentTraceRefs": { "type": "array", "items": { "type": "string", "minLength": 1 } }
            }
          }
        }
      }
    },
    "provenance": { "$ref": "#/definitions/provenance" },
    "diagnostics": { "$ref": "#/definitions/diagnostics" },
    "limitations": { "$ref": "#/definitions/nonEmptyStringArray" },
    "extensions": { "type": "object" }
  },
  "definitions": {
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["package", "version"],
      "properties": {
        "package": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 }
      }
    },
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id"],
      "properties": {
        "kind": { "type": "string", "minLength": 1 },
        "id": { "type": "string", "minLength": 1 }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id"],
          "properties": {
            "id": { "type": "string", "minLength": 1 },
            "sha256": { "type": "string", "minLength": 1 }
          }
        },
        "references": { "type": "array", "items": { "$ref": "#/definitions/reference" } }
      }
    },
    "diagnostics": { "type": "array", "items": { "$ref": "#/definitions/diagnostic" } },
    "diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "severity"],
      "properties": {
        "code": { "type": "string", "minLength": 1 },
        "severity": { "enum": ["info", "warning", "error"] },
        "message": { "type": "string", "minLength": 1 }
      }
    },
    "nonEmptyStringArray": { "type": "array", "items": { "type": "string", "minLength": 1 } }
  }
}
