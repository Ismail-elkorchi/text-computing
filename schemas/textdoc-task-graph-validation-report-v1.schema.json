{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/Ismail-elkorchi/text-computing/schemas/textdoc-task-graph-validation-report-v1.schema.json",
  "title": "textdoc task graph validation report v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "profileId",
    "task",
    "documentId",
    "documentRevision",
    "ok",
    "summary",
    "diagnostics",
    "evidenceRefs",
    "limitations"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "profileId": { "type": "string", "minLength": 1 },
    "task": { "type": "string", "minLength": 1 },
    "documentId": { "type": "string", "minLength": 1 },
    "documentRevision": { "type": "string", "minLength": 1 },
    "ok": { "type": "boolean" },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "viewRequirements",
        "layerRequirements",
        "annotationPatternRequirements",
        "relationArgumentRequirements",
        "coverageRequirements",
        "passCount",
        "failCount",
        "diagnosticCount"
      ],
      "properties": {
        "viewRequirements": { "type": "integer", "minimum": 0 },
        "layerRequirements": { "type": "integer", "minimum": 0 },
        "annotationPatternRequirements": { "type": "integer", "minimum": 0 },
        "relationArgumentRequirements": { "type": "integer", "minimum": 0 },
        "coverageRequirements": { "type": "integer", "minimum": 0 },
        "passCount": { "type": "integer", "minimum": 0 },
        "failCount": { "type": "integer", "minimum": 0 },
        "diagnosticCount": { "type": "integer", "minimum": 0 }
      }
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "severity", "message", "profileId"],
        "properties": {
          "code": { "type": "string", "minLength": 1 },
          "severity": { "enum": ["error", "warning"] },
          "message": { "type": "string", "minLength": 1 },
          "profileId": { "type": "string", "minLength": 1 },
          "requirementId": { "type": "string", "minLength": 1 },
          "viewId": { "type": "string", "minLength": 1 },
          "layerId": { "type": "string", "minLength": 1 },
          "annotationId": { "type": "string", "minLength": 1 },
          "targetId": { "type": "string", "minLength": 1 }
        }
      }
    },
    "evidenceRefs": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/referenceRef" }
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "notes": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "definitions": {
    "referenceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id"],
      "properties": {
        "kind": { "type": "string", "minLength": 1 },
        "id": { "type": "string", "minLength": 1 }
      }
    }
  }
}
