{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/Ismail-elkorchi/text-computing/schemas/retrieval-qrels-v1.schema.json",
  "title": "Retrieval qrels v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "taskId", "corpusId", "judgments"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "taskId": { "const": "nlp-retrieval" },
    "corpusId": { "type": "string", "minLength": 1 },
    "judgments": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/judgment" }
    }
  },
  "definitions": {
    "judgment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["queryId", "ratings"],
      "properties": {
        "queryId": { "type": "string", "minLength": 1 },
        "ratings": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/rating" }
        }
      }
    },
    "rating": {
      "type": "object",
      "additionalProperties": false,
      "required": ["docId", "grade"],
      "properties": {
        "docId": { "type": "string", "minLength": 1 },
        "grade": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
