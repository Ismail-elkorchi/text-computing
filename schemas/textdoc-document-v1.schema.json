{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/Ismail-elkorchi/text-computing/schemas/textdoc-document-v1.schema.json",
  "title": "textdoc document annotation model v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "documentId",
    "revision",
    "textLengthCU",
    "units",
    "views",
    "layers"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "documentId": { "type": "string", "minLength": 1 },
    "revision": { "type": "string", "minLength": 1 },
    "textLengthCU": { "type": "integer", "minimum": 0 },
    "text": { "type": "string" },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "unicodeVersion": { "type": "string", "minLength": 1 },
    "units": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text"],
      "properties": {
        "text": { "const": "utf16-code-unit" }
      }
    },
    "views": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/view" }
    },
    "layers": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/layer" }
    },
    "notes": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "definitions": {
    "referenceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id"],
      "properties": {
        "kind": { "type": "string", "minLength": 1 },
        "id": { "type": "string", "minLength": 1 }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id"],
          "properties": {
            "id": { "type": "string", "minLength": 1 },
            "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
          }
        },
        "references": {
          "type": "array",
          "items": { "$ref": "#/definitions/referenceRef" }
        }
      }
    },
    "view": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["source", "analysis"] },
        "description": { "type": "string", "minLength": 1 },
        "derivedFrom": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "lifecycle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state"],
      "properties": {
        "state": { "enum": ["active", "superseded", "retracted"] },
        "supersedes": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "supersededBy": { "type": "string", "minLength": 1 },
        "reason": { "type": "string", "minLength": 1 }
      }
    },
    "spanTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "startCU", "endCU"],
      "properties": {
        "kind": { "const": "span" },
        "startCU": { "type": "integer", "minimum": 0 },
        "endCU": { "type": "integer", "minimum": 0 }
      }
    },
    "documentTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": { "const": "document" }
      }
    },
    "annotationTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "annotationId"],
      "properties": {
        "kind": { "const": "annotation" },
        "annotationId": { "type": "string", "minLength": 1 }
      }
    },
    "target": {
      "oneOf": [
        { "$ref": "#/definitions/spanTarget" },
        { "$ref": "#/definitions/documentTarget" },
        { "$ref": "#/definitions/annotationTarget" }
      ]
    },
    "stringAlternative": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "rank", "value"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "rank": { "type": "integer", "minimum": 1 },
        "value": { "type": "string", "minLength": 1 },
        "notes": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "feature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "value"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "value": { "type": "string", "minLength": 1 }
      }
    },
    "morphologyAlternative": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "rank", "features"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "rank": { "type": "integer", "minimum": 1 },
        "features": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/feature" }
        },
        "notes": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "confidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value"],
      "properties": {
        "value": { "type": "number", "minimum": 0, "maximum": 1 },
        "method": { "type": "string", "minLength": 1 }
      }
    },
    "lossMarker": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "reason"],
      "properties": {
        "kind": {
          "enum": ["lossy-normalization", "omitted-alternative", "truncated-context", "external-reference"]
        },
        "reason": { "type": "string", "minLength": 1 },
        "source": { "type": "string", "minLength": 1 }
      }
    },
    "ambiguitySetRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "role"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "role": { "enum": ["candidate", "selected", "rejected"] },
        "rank": { "type": "integer", "minimum": 1 }
      }
    },
    "externalDocumentRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["documentId", "role"],
      "properties": {
        "documentId": { "type": "string", "minLength": 1 },
        "role": { "type": "string", "minLength": 1 },
        "revision": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "annotationBase": {
      "type": "object",
      "required": ["id", "kind", "lifecycle", "targets"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "kind": {
          "enum": ["token", "sentence", "pos", "lemma", "morphology", "entity", "relation", "coreference-mention", "coreference-chain", "entity-link", "corpus-feature", "dependency-node", "dependency", "extension"]
        },
        "lifecycle": { "$ref": "#/definitions/lifecycle" },
        "targets": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/target" }
        },
        "notes": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "provenance": { "$ref": "#/definitions/provenance" },
        "confidence": { "$ref": "#/definitions/confidence" },
        "loss": {
          "type": "array",
          "items": { "$ref": "#/definitions/lossMarker" }
        },
        "ambiguitySet": { "$ref": "#/definitions/ambiguitySetRef" },
        "documentRefs": {
          "type": "array",
          "items": { "$ref": "#/definitions/externalDocumentRef" }
        }
      }
    },
    "tokenAnnotation": {
      "allOf": [
        { "$ref": "#/definitions/annotationBase" },
        {
          "type": "object",
          "required": ["tokenKind"],
          "properties": {
            "kind": { "const": "token" },
            "tokenKind": { "enum": ["uax29-word-boundary-token", "lexical-token"] },
            "text": { "type": "string" },
            "targets": {
              "type": "array",
              "minItems": 1,
              "maxItems": 1,
              "items": { "$ref": "#/definitions/spanTarget" }
            }
          }
        }
      ]
    },
    "sentenceAnnotation": {
      "allOf": [
        { "$ref": "#/definitions/annotationBase" },
        {
          "type": "object",
          "required": ["sentenceKind"],
          "properties": {
            "kind": { "const": "sentence" },
            "sentenceKind": { "const": "uax29-sentence" },
            "text": { "type": "string" },
            "sourceComments": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 }
            },
            "targets": {
              "type": "array",
              "minItems": 1,
              "maxItems": 1,
              "items": { "$ref": "#/definitions/spanTarget" }
            }
          }
        }
      ]
    },
    "posAnnotation": {
      "allOf": [
        { "$ref": "#/definitions/annotationBase" },
        {
          "type": "object",
          "required": ["tagSet", "alternatives"],
          "properties": {
            "kind": { "const": "pos" },
            "tagSet": { "type": "string", "minLength": 1 },
            "alternatives": {
              "type": "array",
              "minItems": 1,
              "items": { "$ref": "#/definitions/stringAlternative" }
            },
            "targets": {
              "type": "array",
              "minItems": 1,
              "maxItems": 1,
              "items": { "$ref": "#/definitions/annotationTarget" }
            }
          }
        }
      ]
    },
    "lemmaAnnotation": {
      "allOf": [
        { "$ref": "#/definitions/annotationBase" },
        {
          "type": "object",
          "required": ["alternatives"],
          "properties": {
            "kind": { "const": "lemma" },
            "alternatives": {
              "type": "array",
              "minItems": 1,
              "items": { "$ref": "#/definitions/stringAlternative" }
            },
            "targets": {
              "type": "array",
              "minItems": 1,
              "maxItems": 1,
              "items": { "$ref": "#/definitions/annotationTarget" }
            }
          }
        }
      ]
    },
    "morphologyAnnotation": {
      "allOf": [
        { "$ref": "#/definitions/annotationBase" },
        {
          "type": "object",
          "required": ["alternatives"],
          "properties": {
            "kind": { "const": "morphology" },
            "alternatives": {
              "type": "array",
              "minItems": 1,
              "items": { "$ref": "#/definitions/morphologyAlternative" }
            },
            "targets": {
              "type": "array",
              "minItems": 1,
              "maxItems": 1,
              "items": { "$ref": "#/definitions/annotationTarget" }
            }
          }
        }
      ]
    },
    "entityAnnotation": {
      "allOf": [
        { "$ref": "#/definitions/annotationBase" },
        {
          "type": "object",
          "required": ["label"],
          "properties": {
            "kind": { "const": "entity" },
            "label": { "type": "string", "minLength": 1 },
            "normalized": { "type": "string", "minLength": 1 },
            "text": { "type": "string" },
            "targets": {
              "type": "array",
              "minItems": 1,
              "items": { "$ref": "#/definitions/spanTarget" }
            }
          }
        }
      ]
    },
    "relationArgument": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "annotationId"],
      "properties": {
        "role": { "type": "string", "minLength": 1 },
        "annotationId": { "type": "string", "minLength": 1 }
      }
    },
    "relationAnnotation": {
      "allOf": [
        { "$ref": "#/definitions/annotationBase" },
        {
          "type": "object",
          "required": ["relationType", "arguments"],
          "properties": {
            "kind": { "const": "relation" },
            "relationType": { "type": "string", "minLength": 1 },
            "arguments": {
              "type": "array",
              "minItems": 2,
              "items": { "$ref": "#/definitions/relationArgument" }
            },
            "targets": {
              "type": "array",
              "minItems": 1,
              "items": { "$ref": "#/definitions/annotationTarget" }
            }
          }
        }
      ]
    },
    "coreferenceMentionAnnotation": {
      "allOf": [
        { "$ref": "#/definitions/annotationBase" },
        {
          "type": "object",
          "required": ["mentionType"],
          "properties": {
            "kind": { "const": "coreference-mention" },
            "mentionType": { "type": "string", "minLength": 1 },
            "text": { "type": "string" },
            "targets": {
              "type": "array",
              "minItems": 1,
              "items": {
                "oneOf": [
                  { "$ref": "#/definitions/spanTarget" },
                  { "$ref": "#/definitions/annotationTarget" }
                ]
              }
            }
          }
        }
      ]
    },
    "coreferenceChainAnnotation": {
      "allOf": [
        { "$ref": "#/definitions/annotationBase" },
        {
          "type": "object",
          "required": ["mentionIds"],
          "properties": {
            "kind": { "const": "coreference-chain" },
            "mentionIds": {
              "type": "array",
              "minItems": 1,
              "items": { "type": "string", "minLength": 1 }
            },
            "representativeMentionId": { "type": "string", "minLength": 1 },
            "targets": {
              "type": "array",
              "minItems": 1,
              "items": { "$ref": "#/definitions/annotationTarget" }
            }
          }
        }
      ]
    },
    "entityLinkRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["namespace", "id"],
      "properties": {
        "namespace": { "type": "string", "minLength": 1 },
        "id": { "type": "string", "minLength": 1 }
      }
    },
    "entityLinkNil": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reason"],
      "properties": {
        "reason": { "type": "string", "minLength": 1 }
      }
    },
    "entityLinkAnnotation": {
      "allOf": [
        { "$ref": "#/definitions/annotationBase" },
        {
          "type": "object",
          "properties": {
            "kind": { "const": "entity-link" },
            "link": { "$ref": "#/definitions/entityLinkRef" },
            "nil": { "$ref": "#/definitions/entityLinkNil" },
            "targets": {
              "type": "array",
              "minItems": 1,
              "maxItems": 1,
              "items": { "$ref": "#/definitions/annotationTarget" }
            }
          },
          "anyOf": [
            {
              "required": ["link"],
              "properties": {
                "link": { "$ref": "#/definitions/entityLinkRef" }
              }
            },
            {
              "required": ["nil"],
              "properties": {
                "nil": { "$ref": "#/definitions/entityLinkNil" }
              }
            }
          ]
        }
      ]
    },
    "corpusFeatureAnnotation": {
      "allOf": [
        { "$ref": "#/definitions/annotationBase" },
        {
          "type": "object",
          "required": ["featureName"],
          "properties": {
            "kind": { "const": "corpus-feature" },
            "featureName": { "type": "string", "minLength": 1 },
            "formula": { "type": "string", "minLength": 1 },
            "value": { "type": "string", "minLength": 1 },
            "numericValue": { "type": "number" }
          }
        }
      ]
    },
    "extensionSchemaRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaId"],
      "properties": {
        "schemaId": { "type": "string", "minLength": 1 },
        "schemaVersion": { "type": "string", "minLength": 1 }
      }
    },
    "extensionAnnotation": {
      "allOf": [
        { "$ref": "#/definitions/annotationBase" },
        {
          "type": "object",
          "required": ["extensionId"],
          "properties": {
            "kind": { "const": "extension" },
            "extensionId": { "type": "string", "pattern": "^[a-z][a-z0-9+.-]*:[^\\s]+$" },
            "extensionSchema": { "$ref": "#/definitions/extensionSchemaRef" },
            "data": {
              "type": "object",
              "additionalProperties": true
            }
          }
        }
      ]
    },
    "conlluFields": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "form", "lemma", "upos", "xpos", "feats", "head", "deprel", "deps", "misc"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "form": { "type": "string" },
        "lemma": { "type": "string" },
        "upos": { "type": "string" },
        "xpos": { "type": "string" },
        "feats": { "type": "string" },
        "head": { "type": "string" },
        "deprel": { "type": "string" },
        "deps": { "type": "string" },
        "misc": { "type": "string" }
      }
    },
    "dependencyNodeAnnotation": {
      "allOf": [
        { "$ref": "#/definitions/annotationBase" },
        {
          "type": "object",
          "required": ["nodeKind", "sentenceId", "sourceOrder", "fields"],
          "properties": {
            "kind": { "const": "dependency-node" },
            "nodeKind": { "enum": ["word", "multiword-token", "empty-node"] },
            "sentenceId": { "type": "string", "minLength": 1 },
            "sourceOrder": { "type": "integer", "minimum": 0 },
            "fields": { "$ref": "#/definitions/conlluFields" },
            "targets": {
              "type": "array",
              "minItems": 1,
              "maxItems": 1,
              "items": {
                "oneOf": [
                  { "$ref": "#/definitions/spanTarget" },
                  { "$ref": "#/definitions/annotationTarget" },
                  { "$ref": "#/definitions/documentTarget" }
                ]
              }
            }
          }
        }
      ]
    },
    "dependencyAnnotation": {
      "allOf": [
        { "$ref": "#/definitions/annotationBase" },
        {
          "type": "object",
          "required": ["dependentNodeId", "headNodeId", "relation", "source"],
          "properties": {
            "kind": { "const": "dependency" },
            "dependentNodeId": { "type": "string", "minLength": 1 },
            "headNodeId": {
              "type": ["string", "null"],
              "minLength": 1
            },
            "relation": { "type": "string", "minLength": 1 },
            "source": {
              "type": "object",
              "additionalProperties": false,
              "required": ["sentenceId", "conlluId", "conlluHead", "conlluDeprel", "conlluDeps"],
              "properties": {
                "sentenceId": { "type": "string", "minLength": 1 },
                "conlluId": { "type": "string", "minLength": 1 },
                "conlluHead": { "type": "string" },
                "conlluDeprel": { "type": "string", "minLength": 1 },
                "conlluDeps": { "type": "string" }
              }
            },
            "targets": {
              "type": "array",
              "minItems": 1,
              "items": { "$ref": "#/definitions/annotationTarget" }
            }
          }
        }
      ]
    },
    "annotation": {
      "oneOf": [
        { "$ref": "#/definitions/tokenAnnotation" },
        { "$ref": "#/definitions/sentenceAnnotation" },
        { "$ref": "#/definitions/posAnnotation" },
        { "$ref": "#/definitions/lemmaAnnotation" },
        { "$ref": "#/definitions/morphologyAnnotation" },
        { "$ref": "#/definitions/entityAnnotation" },
        { "$ref": "#/definitions/relationAnnotation" },
        { "$ref": "#/definitions/coreferenceMentionAnnotation" },
        { "$ref": "#/definitions/coreferenceChainAnnotation" },
        { "$ref": "#/definitions/entityLinkAnnotation" },
        { "$ref": "#/definitions/corpusFeatureAnnotation" },
        { "$ref": "#/definitions/dependencyNodeAnnotation" },
        { "$ref": "#/definitions/dependencyAnnotation" },
        { "$ref": "#/definitions/extensionAnnotation" }
      ]
    },
    "layer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "viewId", "annotations"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "kind": {
          "enum": ["token", "sentence", "pos", "lemma", "morphology", "entity", "relation", "coreference-mention", "coreference-chain", "entity-link", "corpus-feature", "dependency-node", "dependency", "extension"]
        },
        "viewId": { "type": "string", "minLength": 1 },
        "allowSpanOverlap": { "type": "boolean" },
        "annotations": {
          "type": "array",
          "items": { "$ref": "#/definitions/annotation" }
        },
        "notes": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
