{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/Ismail-elkorchi/text-computing/schemas/textlab-inspection-session-v1.schema.json",
  "title": "textlab inspection session v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "artifactType",
    "sessionId",
    "subjectId",
    "rowCount",
    "pageSize",
    "pageCount",
    "pageIndex",
    "pageStart",
    "pageEnd",
    "pageRowCount",
    "hasPreviousPage",
    "hasNextPage",
    "pageRows",
    "commandHistory"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "artifactType": { "const": "textlab-inspection-session-v1" },
    "sessionId": { "type": "string", "minLength": 1 },
    "subjectId": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1 },
    "rowCount": { "type": "integer", "minimum": 0 },
    "pageSize": { "type": "integer", "minimum": 1 },
    "pageCount": { "type": "integer", "minimum": 0 },
    "pageIndex": { "type": "integer", "minimum": 0 },
    "pageStart": { "type": "integer", "minimum": 0 },
    "pageEnd": { "type": "integer", "minimum": 0 },
    "pageRowCount": { "type": "integer", "minimum": 0 },
    "hasPreviousPage": { "type": "boolean" },
    "hasNextPage": { "type": "boolean" },
    "pageRows": {
      "type": "array",
      "items": {}
    },
    "commandHistory": {
      "type": "array",
      "items": { "$ref": "#/definitions/commandRecord" }
    }
  },
  "definitions": {
    "commandRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command", "fromPageIndex", "toPageIndex"],
      "properties": {
        "command": {
          "enum": ["first-page", "previous-page", "next-page", "last-page", "goto-page"]
        },
        "fromPageIndex": { "type": "integer", "minimum": 0 },
        "toPageIndex": { "type": "integer", "minimum": 0 },
        "pageIndex": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
